CODEX_CONFIG_MAX_BYTES = 1024 * 1024


@contextmanager
def bundled_tomli():
    """Authenticate before decompress/import; never consult ambient tomli."""
    namespace = None
    bytecode = sys.dont_write_bytecode
    try:
        payload = base64.b85decode(TOMLI_SDIST_B85)
        if (len(payload) != TOMLI_SDIST_SIZE
                or hashlib.sha256(payload).hexdigest() != TOMLI_SDIST_SHA256):
            raise ValueError("payload")
        sources = {}
        with tarfile.open(fileobj=io.BytesIO(payload), mode="r:gz") as archive:
            for member in archive.getmembers():
                relative = member.name.removeprefix("tomli-2.5.0/")
                if relative not in TOMLI_MEMBERS:
                    continue
                size, expected = TOMLI_MEMBERS[relative]
                if (member.name != "tomli-2.5.0/" + relative or relative in sources
                        or not member.isfile() or member.size != size):
                    raise ValueError("member")
                with archive.extractfile(member) as stream:
                    source = stream.read(size + 1)
                if len(source) != size or hashlib.sha256(source).hexdigest() != expected:
                    raise ValueError("member digest")
                sources[relative] = source
        if sources.keys() != TOMLI_MEMBERS.keys():
            raise ValueError("members")
        with tempfile.TemporaryDirectory(prefix="my-ai-skills-tomli-") as temp:
            package = Path(temp) / "tomli"
            package.mkdir(mode=0o700)
            # No extractall, archive-controlled output paths, or setup scripts.
            for relative, source in sources.items():
                target = package / Path(relative).name
                target.write_bytes(source)
                target.chmod(0o600)
            namespace = "_my_ai_skills_tomli_" + Path(temp).name.replace("-", "_")
            if namespace in sys.modules:
                raise ValueError("namespace")
            spec = importlib.util.spec_from_file_location(
                namespace, package / "__init__.py",
                submodule_search_locations=[str(package)])
            module = importlib.util.module_from_spec(spec)
            sys.modules[namespace] = module
            sys.dont_write_bytecode = True
            spec.loader.exec_module(module)
            yield module
    except (OSError, ValueError, ImportError, tarfile.TarError, EOFError) as exc:
        raise InstallError("Parser TOML incorporado inválido; reinstale pela entrada verificada.") from None
    finally:
        sys.dont_write_bytecode = bytecode
        if namespace:
            for name in list(sys.modules):
                if name == namespace or name.startswith(namespace + "."):
                    del sys.modules[name]


def codex_config_error(config, cause, error=None):
    # Never stringify parser/IO exceptions: they may quote a secret input line.
    position = ""
    if error is not None:
        line, column = getattr(error, "lineno", None), getattr(error, "colno", None)
        if type(line) is int and type(column) is int:
            position = f", linha {line}, coluna {column}"
    return InstallError(
        f"Configuração Codex inválida em {config}: {cause}{position}; reconcilie explicitamente.")


def codex_skill_rules(config):
    try:
        with config.open("rb") as stream:
            raw = stream.read(CODEX_CONFIG_MAX_BYTES + 1)
    except OSError:
        raise codex_config_error(config, "leitura") from None
    if len(raw) > CODEX_CONFIG_MAX_BYTES:
        raise codex_config_error(config, "limite de tamanho")
    try:
        text = raw.decode("utf-8")
    except UnicodeError:
        raise codex_config_error(config, "UTF-8") from None
    with bundled_tomli() as parser:
        try:
            document = parser.loads(text)
        except parser.TOMLDecodeError as exc:
            raise codex_config_error(config, "TOML", exc) from None
        except (RecursionError, MemoryError, OverflowError):
            raise codex_config_error(config, "limite do parser") from None
    skills = document.get("skills", {})
    if not isinstance(skills, dict):
        raise codex_config_error(config, "estrutura de skills")
    rules = skills.get("config", [])
    if not isinstance(rules, list):
        raise codex_config_error(config, "estrutura de skills.config")
    for rule in rules:
        if (not isinstance(rule, dict) or not ({"name", "path"} & rule.keys())
                or any(not isinstance(rule[key], str) for key in ("name", "path") if key in rule)
                or ("enabled" in rule and type(rule["enabled"]) is not bool)):
            raise codex_config_error(config, "tipo de regra skills.config")
    return rules


def run(*argv, cwd=None, env=None):
    result = subprocess.run(argv, cwd=cwd, env=env, text=True, capture_output=True)
    if result.returncode:
        raise InstallError(f"{' '.join(map(str, argv))}: {result.stderr.strip() or result.stdout.strip()}")
    return result.stdout.strip()


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def read_utf8(path):
    # Path.read_text() normalizes CRLF; unmanaged instruction bytes must survive.
    return path.read_bytes().decode("utf-8")


def absent_or_regular(path):
    if path.is_symlink() or (path.exists() and not path.is_file()):
        raise InstallError(f"Caminho inseguro ou de outra origem: {path}")


def safe_parent(path, stop):
    for ancestor in (path, *path.parents):
        if ancestor.is_symlink():
            raise InstallError(f"Diretório symlink não confiável: {ancestor}")


def preflight(home, agents):
    if not agents or not set(agents) <= set(SUPPORTED_AGENTS):
        raise InstallError("Selecione --agent opencode ou --agent codex (repetível para ambos).")
    if os.name != "posix" or platform.system() not in ("Linux", "Darwin"):
        raise InstallError("Plataforma não suportada: use Linux ou macOS POSIX.")
    if sys.version_info < (3, 10):
        raise InstallError("Python 3.10+ necessário; instale-o antes de continuar.")
    for executable in ("git", "gh", "jq", "curl", *agents):
        if not shutil.which(executable):
            raise InstallError(f"Falta {executable} no PATH; instale-o antes de continuar.")
    if "opencode" in agents:
        opencode = shutil.which("opencode")
        version = run(opencode, "--version")
        help_text = run(opencode, "--help")
        if not re.search(r"\bv2\.\d+\.\d+\b", version) or not all(
            re.search(r"^ *" + token + r"\b", help_text, re.MULTILINE)
            for token in ("api", "run", "service")
        ):
            raise InstallError("OpenCode V2 com API, run e service é necessário; instale/atualize OpenCode V2.")
    if "codex" in agents:
        version = run("codex", "--version")
        help_text = run("codex", "exec", "--help")
        if not re.fullmatch(r"codex-cli \d+\.\d+\.\d+(?:[-+][\w.-]+)?", version) or not all(
            flag in help_text for flag in ("--json", "--cd", "--ephemeral", "--sandbox")
        ):
            raise InstallError("Codex CLI com exec --json/--cd/--ephemeral/--sandbox necessário; atualize pela origem.")
    if not home.is_dir():
        raise InstallError(f"HOME inválido: {home}")


def ensure_openspec(data, env):
    existing = shutil.which("openspec", path=env.get("PATH"))
    if existing:
        version = run(existing, "--version", env=env)
        if not re.fullmatch(r"(?:openspec(?: cli)?\s+)?v?2\.\d+\.\d+(?:[-+][0-9a-z.-]+)?",
                            version, re.IGNORECASE):
            raise InstallError(
                f"OpenSpec 2.x necessário para as skills nativas; CLI existente em {existing} "
                f"reporta {version!r}. Atualize o CLI pela instalação de sua origem e repita; "
                "o instalador não substituirá o CLI existente.")
        return existing
    # The upstream standalone installer checks the released binary against
    # SHA256SUMS. It is used only when no existing method owns this tool.
    with tempfile.TemporaryDirectory(prefix="openspec-install-") as temp:
        script = Path(temp) / "install.sh"
        run("curl", "-fsSL", f"https://raw.githubusercontent.com/Fission-AI/OpenSpec/{OPENSPEC_INSTALL_REVISION}/scripts/binary/install.sh", "-o", str(script), env=env)
        if digest(script) != OPENSPEC_INSTALL_SHA256:
            raise InstallError("Digest do instalador OpenSpec divergente; não executar.")
        target = data / "bin"
        target.mkdir(parents=True, exist_ok=True)
        installer_env = {**env, "OPENSPEC_INSTALL_DIR": str(target)}
        run("bash", str(script), env=installer_env)
        binary = target / "openspec"
        if not binary.is_file():
            raise InstallError("OpenSpec standalone não foi instalado; consulte https://github.com/Fission-AI/OpenSpec/blob/main/docs/installation.md")
        version = run(str(binary), "--version", env=env)
        if not re.fullmatch(r"(?:openspec(?: cli)?\s+)?v?2\.\d+\.\d+(?:[-+][0-9a-z.-]+)?",
                            version, re.IGNORECASE):
            raise InstallError(f"Distribuição OpenSpec incompatível ({version!r}); exige 2.x.")
        if shutil.which("openspec", path=env.get("PATH")) != str(binary):
            raise InstallError(f"OpenSpec instalado em {binary}, mas fora do PATH. Adicione {target} ao PATH e repita.")
        return str(binary)


def fetch_snapshot(revision, source, temp):
    repo = temp / "source"
    run("git", "init", "-q", str(repo))
    run("git", "-C", str(repo), "remote", "add", "origin", source)
    run("git", "-C", str(repo), "fetch", "-q", "--depth", "1", "origin", revision)
    fetched = run("git", "-C", str(repo), "rev-parse", "FETCH_HEAD^{commit}")
    if fetched != revision:
        raise InstallError("Snapshot não corresponde ao SHA aprovado.")
    run("git", "-C", str(repo), "checkout", "-q", "--detach", revision)
    if run("git", "-C", str(repo), "rev-parse", "HEAD") != revision:
        raise InstallError("Revisão do checkout divergente.")
    run("git", "-C", str(repo), "fsck", "--no-reflogs", "--connectivity-only")
    for component in COMPONENTS:
        if (repo / component).is_symlink() or not (repo / component).is_dir():
            raise InstallError(f"Snapshot incompleto: {component}")
    if not (repo / "scripts" / "sync-skill-references").is_file():
        raise InstallError("Snapshot sem gerador independente de referências.")
    return repo


def manifest_for(root, revision, agents=None, *, schema=2):
    entries = {}
    directories = {}
    skills = sorted(p.name for p in (root / "skills").iterdir() if (p / "SKILL.md").is_file())
    for component in COMPONENTS:
        directories[component] = stat.S_IMODE((root / component).stat().st_mode)
        for path in (root / component).rglob("*"):
            if path.is_symlink():
                raise InstallError(f"Symlink inesperado no snapshot: {path}")
            if path.is_file():
                relative = path.relative_to(root).as_posix()
                entries[relative] = {"sha256": digest(path), "mode": stat.S_IMODE(path.stat().st_mode)}
            elif path.is_dir():
                directories[path.relative_to(root).as_posix()] = stat.S_IMODE(path.stat().st_mode)
    for name in ("worktree-reservation", "workflow-evidence"):
        if f"scripts/{name}" not in entries:
            raise InstallError(f"Helper ausente: {name}")
    integrations = {agent: {"skills": ["skills/" + name for name in skills],
                            "instructions": "AGENTS.md", "ownership": "guidance.json"}
                    for agent in (("opencode",) if schema == 1 else SUPPORTED_AGENTS)}
    result = {"schema": schema, "origin": ORIGIN, "revision": revision,
              "files": entries, "directories": directories, "integrations": integrations}
    result["agents" if schema == 1 else "available_agents"] = (
        ["opencode"] if schema == 1 else list(SUPPORTED_AGENTS))
    return result


def validate_manifest(root, manifest, staged=False, allow_extras=False):
    if (not isinstance(manifest, dict) or type(manifest.get("schema")) is not int
            or manifest.get("schema") not in (1, 2)
            or manifest.get("origin") != ORIGIN
            or not isinstance(manifest.get("revision"), str)
            or not re.fullmatch(r"[0-9a-f]{40}", manifest.get("revision", ""))
            or (not staged and root.name != manifest["revision"])
            or (manifest.get("agents") != ["opencode"] if manifest.get("schema") == 1
                else manifest.get("available_agents") != list(SUPPORTED_AGENTS))
            or not isinstance(manifest.get("files"), dict) or not manifest["files"]
            or not isinstance(manifest.get("integrations"), dict)):
        raise InstallError(f"Manifesto sem propriedade comprovada: {root}")
    actual = set()
    actual_dirs = set()
    for directory, dirs, files in os.walk(root, followlinks=False):
        for name in dirs + files:
            path = Path(directory) / name
            if path.is_symlink() or (not path.is_dir() and not path.is_file()):
                raise InstallError(f"Entrada inesperada no pacote: {path}")
            if path.is_file():
                actual.add(path.relative_to(root).as_posix())
            else:
                actual_dirs.add(path.relative_to(root).as_posix())
    expected = set(manifest["files"]) | {"manifest.json"}
    missing = expected - actual
    if missing:
        raise InstallError("Arquivos gerenciados ausentes: " + ", ".join(str(root / p) for p in sorted(missing)))
    expected_dirs = manifest.get("directories")
    if expected_dirs is None:  # Legacy manifest from the previously published entrypoint.
        expected_dirs = {parent for item in manifest["files"] for parent in (
            Path(item).parents) if str(parent) != "."}
        expected_dirs = {str(parent) for parent in expected_dirs}
    missing_dirs = set(expected_dirs) - actual_dirs
    if missing_dirs:
        raise InstallError("Diretórios gerenciados ausentes: " + ", ".join(str(root / p) for p in sorted(missing_dirs)))
    extras = (actual - expected) | (actual_dirs - set(expected_dirs))
    # Only untracked cache entries are disposable; managed files always retain
    # their hash/mode validation, even if their name resembles a cache.
    def cache(relative):
        path = Path(relative)
        return "__pycache__" in path.parts or path.suffix in {".pyc", ".pyo"}
    unknown = sorted(p for p in extras if staged or not cache(p))
    if unknown and not allow_extras:
        raise InstallError("Entradas extras no pacote: " + ", ".join(str(root / p) for p in unknown))
    if isinstance(expected_dirs, dict):
        for relative, mode in expected_dirs.items():
            if not isinstance(mode, int) or stat.S_IMODE((root / relative).stat().st_mode) != mode:
                raise InstallError(f"Diretório gerenciado modificado: {root / relative}")
    for relative, info in manifest["files"].items():
        path = root / relative
        if (relative.split("/", 1)[0] not in COMPONENTS or Path(relative).is_absolute()
                or ".." in Path(relative).parts or not isinstance(info, dict)
                or not isinstance(info.get("sha256"), str)
                or not re.fullmatch(r"[0-9a-f]{64}", info["sha256"])
                or not isinstance(info.get("mode"), int)
                or not path.is_file() or path.is_symlink() or digest(path) != info["sha256"]
                or stat.S_IMODE(path.stat().st_mode) != info["mode"]):
            raise InstallError(f"Arquivo gerenciado modificado: {path}")
    if not (root / "manifest.json").is_file() or json.loads((root / "manifest.json").read_text()) != manifest:
        raise InstallError(f"Manifesto divergente: {root}")

    return [str(root / p) for p in unknown]


def guidance(data):
    return f"""{BEGIN}
AI Engineering Workflow global: pacote em {data}/active (skills/, protocol/,
templates/, scripts/). Use `worktree-reservation verify --session <id>` no checkout
atual; se o launcher global não estiver disponível, use
`{data}/active/scripts/worktree-reservation verify --path <checkout> --session <id>`.
Não infira sessão do owner. Use --json para automação e preserve o exit status;
cite argumentos e caminhos com espaços.
Referências nas skills são relativas ao pacote global, nunca ao projeto atual.
Regras locais AGENTS.md e instruções do usuário, especialmente restrições mais
fortes, prevalecem; nenhuma permissão ou execução é concedida por este bloco.
Estado, reservas, logs e evidências continuam no Git common dir do checkout.

Retomada após crash/reboot ou nova sessão: para "continue de onde parou",
"retome o desenvolvimento" ou pedido equivalente, leia primeiro a skill global
resume-workflow; identifique por evidência o checkout/issue/milestone correto
antes de escrever e depois use o milestone-orchestrator existente.
Não confie somente na conversa anterior, em timestamp/PID ausente ou na
última branch. Se houver escopo/posse ambíguos, preserve o trabalho e
peça apenas a identificação necessária; nunca faça takeover inseguro.

OpenSpec no primeiro uso: confira `openspec context --json` e
`openspec list --json` no root pretendido; inspecione o perfil real do CLI
2.x e as skills oficiais Explore, Propose, Apply, Verify e Archive em
.agents/skills/openspec-{{explore,propose,apply-change,verify-change,archive-change}}/SKILL.md
(ou paths efetivamente gerados pelo perfil), além de outras skills exigidas.
Não exija comandos /opsx-* ausentes no perfil 2.0. Diferencie essas skills
locais das skills do pacote global.
Não execute init/update durante instalação global nem sem autorização.
Novo projeto: confirme root e inventarie resíduos .opencode/, .agents/,
.claude/, instruções marcadas e prompts legados no HOME; se houver impacto,
peça aprovação específica antes de `openspec init --tools <agente>` (confirme
as opções suportadas pelo CLI instalado).
Projeto existente completo: use como está. Incompleto: inspecione
`openspec update --dry-run --json`, ferramentas configuradas, diferenças,
arquivos customizados, propriedade dos gerados e efeitos globais antes de
pedir autorização específica para update ou limpeza. Preserve versão anterior
em conflito/falha; não remova personalizações nem arquivos de origem incerta.
Se o agente selecionado (OpenCode ou Codex) não estiver configurado, só proponha `openspec init --tools`
com união explícita de ferramentas existentes + agente selecionado após aprovar qualquer
limpeza; sem preservação garantida, bloqueie sem escrever. Nunca use --force.
Verify oficial é padrão quando suportado: preserve workflows existentes ao
habilitá-lo no perfil oficial. Use --scope project somente quando suportado.
Compare config/specs/changes antes e depois. Abra sessão nativa NOVA do agente e
comprove descoberta e invocação das cinco skills oficiais nativas;
sem essa prova reporte bloqueio, não declare bootstrap concluído.
{END}
"""


def baseline_guidance(repo, data):
    """Reproduce only the literal template, NEVER execute a downloaded module."""
    module = ast.parse((repo / "scripts/install-global").read_text())
    function = next(node for node in module.body
                    if isinstance(node, ast.FunctionDef) and node.name == "guidance")
    template = next(node.value for node in function.body if isinstance(node, ast.Return))

    def literal(node):
        if isinstance(node, ast.Constant) and isinstance(node.value, str):
            return node.value
        if isinstance(node, ast.Name) and node.id in ("data", "BEGIN", "END"):
            return {"data": str(data), "BEGIN": BEGIN, "END": END}[node.id]
        if isinstance(node, ast.JoinedStr):
            return "".join(literal(value) for value in node.values)
        if (isinstance(node, ast.FormattedValue) and node.conversion == -1
                and node.format_spec is None):
            return literal(node.value)
        raise InstallError("Template histórico não reconhecido; preserve e reconcilie manualmente.")
    return literal(template).rstrip("\n")


def integration_paths(home, env):
    config = Path(env.get("XDG_CONFIG_HOME", str(home / ".config"))).absolute() / "opencode"
    codex = Path(env.get("CODEX_HOME", str(home / ".codex"))).absolute()
    return {"opencode": (config / "skills", config / "AGENTS.md"),
            "codex": (home / ".agents/skills", codex / "AGENTS.md")}


def managed_block(text):
    if (text.count(BEGIN) != 1 or text.count(END) != 1
            or text.index(BEGIN) > text.index(END)):
        raise InstallError("Bloco AGENTS.md alterado/inconsistente; não substituir.")
    return text[text.index(BEGIN):text.index(END) + len(END)]


def installed_selection(record, prior, data, paths, revision):
    if not prior:
        if record is not None:
            raise InstallError("Registro global sem pacote ativo verificável.")
        return []
    if not isinstance(record, dict) or type(record.get("schema")) is not int:
        raise InstallError("Pacote ativo sem registro global comprovado.")
    expected_hash = hashlib.sha256(baseline_guidance(prior, data).encode()).hexdigest()
    trusted_hashes = {expected_hash, hashlib.sha256(guidance(data).rstrip("\n").encode()).hexdigest()}
    if record.get("schema") == 1:
        if (set(record) != {"schema", "sha256"} or not isinstance(record.get("sha256"), str)
                or record["sha256"] not in trusted_hashes):
            raise InstallError("Orientação global personalizada/sem baseline.")
        entries = {"opencode": {"skills": str(paths["opencode"][0]),
                                "instructions": str(paths["opencode"][1]), "sha256": record["sha256"]}}
    elif record.get("schema") == 2 and set(record) == {"schema", "revision", "agents"}:
        if record.get("revision") != revision:
            raise InstallError("Ownership e revisão ativa inconsistentes; preserve o estado parcial e reconcilie explicitamente.")
        entries = record["agents"]
        if not isinstance(entries, dict) or not entries or not set(entries) <= set(SUPPORTED_AGENTS):
            raise InstallError("Seleção instalada inválida.")
    else:
        raise InstallError("Registro global sem propriedade comprovada.")
    for agent, entry in entries.items():
        skills, instructions = paths[agent]
        if (not isinstance(entry, dict) or not isinstance(entry.get("sha256"), str)
                or entry["sha256"] not in trusted_hashes
                or entry != {"skills": str(skills), "instructions": str(instructions), "sha256": entry.get("sha256")}):
            raise InstallError(f"Paths/ownership de {agent} divergentes; reconcilie CODEX_HOME/XDG explicitamente.")
        for path in (skills, instructions):
            safe_parent(path, Path(path.anchor))
        absent_or_regular(instructions)
        text = read_utf8(instructions) if instructions.exists() else ""
        if not text:
            raise InstallError("Registro global existe, mas orientação foi removida.")
        if hashlib.sha256(managed_block(text).encode()).hexdigest() != entry["sha256"]:
            raise InstallError("Orientação global personalizada; não sobrescrever.")
    for agent in set(SUPPORTED_AGENTS) - set(entries):
        instructions = paths[agent][1]
        if instructions.is_file() and not instructions.is_symlink():
            text = read_utf8(instructions)
            if BEGIN in text or END in text:
                block_hash = hashlib.sha256(managed_block(text).encode()).hexdigest()
                if block_hash in trusted_hashes:
                    raise InstallError(f"Seleção instalada inconsistente: orientação {agent} sem ownership.")
    return sorted(entries)


def inspect_codex(skills, instructions, skill_names):
    override = instructions.with_name("AGENTS.override.md")
    absent_or_regular(override)
    if override.exists() and override.read_text().strip():
        raise InstallError(f"Orientação Codex sombreada por {override}; reconcilie explicitamente, sem editar automaticamente.")
    config = instructions.with_name("config.toml")
    absent_or_regular(config)
    if config.exists():
        for rule in codex_skill_rules(config):
            if rule.get("enabled") is False and (
                    rule.get("name") in skill_names
                    or any(part in skill_names for part in Path(rule.get("path", "")).parts)):
                raise InstallError(f"Regra de skill Codex desabilitada em {config}; confira precedência/paths e reconcilie explicitamente.")
    deprecated = instructions.parent / "skills"
    safe_parent(deprecated, Path(deprecated.anchor))
    for name in skill_names:
        duplicate = deprecated / name
        if deprecated != skills and (duplicate.exists() or duplicate.is_symlink()):
            raise InstallError(f"Skill Codex homônima/ambígua: {duplicate}; preserve e reconcilie explicitamente.")


def updated_guidance(existing, block):
    if BEGIN in existing or END in existing:
        if existing.count(BEGIN) != 1 or existing.count(END) != 1 or existing.index(BEGIN) > existing.index(END):
            raise InstallError("Bloco AGENTS.md alterado/inconsistente; não substituir.")
        start = existing.index(BEGIN)
        finish = existing.index(END) + len(END)
        # Preserve all content outside the managed block byte-for-byte.
        return existing[:start] + block.rstrip("\n") + existing[finish:]
    return existing + ("\n" if existing and not existing.endswith("\n") else "") + block


def tree_matches(actual, baseline):
    """Compare all bytes, modes and directory entries; never follow symlinks."""
    if actual.is_symlink() or not actual.is_dir() or not baseline.is_dir():
        return False
    def entries(root):
        result = {}
        for directory, dirs, files in os.walk(root, followlinks=False):
            for name in dirs + files:
                path = Path(directory) / name
                if path.is_symlink():
                    return None
                key = path.relative_to(root).as_posix()
                result[key] = ("dir" if path.is_dir() else "file",
                               stat.S_IMODE(path.stat().st_mode),
                               digest(path) if path.is_file() else None)
        return result
    return (stat.S_IMODE(actual.stat().st_mode) == stat.S_IMODE(baseline.stat().st_mode)
            and entries(actual) == entries(baseline))


def legacy_matches(path, baseline, home):
    if path.is_symlink():
        # skills.sh commonly links an agent directory to its universal copy.
        canonical = home / ".agents/skills" / path.name
        if path.resolve() != canonical.absolute() or canonical.is_symlink():
            return False
        return tree_matches(canonical, baseline)
    return tree_matches(path, baseline)


def skill_lock(home, env):
    state = Path(env.get("XDG_STATE_HOME", str(home / ".agents")))
    path = state / "skills/.skill-lock.json" if "XDG_STATE_HOME" in env else state / ".skill-lock.json"
    if not path.is_file() or path.is_symlink():
        return {}
    try:
        lock = json.loads(path.read_text())
        return lock["skills"] if isinstance(lock.get("skills"), dict) else {}
    except (ValueError, KeyError):
        return {}


def legacy_baseline(name, entry, source, temp):
    if (not isinstance(entry, dict) or entry.get("source") != "rocker-code/my-ai-skills"
            or entry.get("sourceType") != "github"
            or not re.fullmatch(r"[0-9a-f]{40}", entry.get("ref", ""))
            or entry.get("skillPath") not in (f"skills/{name}", f"skills/{name}/SKILL.md")):
        return None
    try:
        return fetch_snapshot(entry["ref"], source, temp) / "skills" / name
    except InstallError:
        return None


def inspect_local(project, old_repo, new_repo, authorized):
    """Only paths under the explicitly identified root; return planned safe removals."""
    if project is None:
        if authorized:
            raise InstallError("--reconcile-path exige --project explícito.")
        return [], []
    if ".." in Path(project).parts:
        raise InstallError(f"Projeto com percurso ambíguo: {project}")
    project = Path(project).absolute()
    # Authorization is for this physical root, never a lexical path through
    # another project's symlink (including the root's parent).
    safe_parent(project, Path(project.anchor))
    if project.resolve() != project:
        raise InstallError(f"Projeto fora da raiz canônica autorizada: {project}")
    if project.is_symlink() or not project.is_dir():
        raise InstallError(f"Projeto inválido: {project}")
    pending, eligible = [], []
    roots = {".opencode/skills": "skills", ".agents/skills": "skills", ".codex/skills": "skills", ".ai-workflow/skills": "skills",
             ".ai-workflow/protocol": "protocol", ".ai-workflow/templates": "templates",
              ".ai-workflow/scripts": "scripts"}
    package_skills = {item.name for item in (new_repo / "skills").iterdir()
                      if (item / "SKILL.md").is_file()}
    for prefix, component in roots.items():
        root = project / prefix
        safe_parent(root, project)
        if root.is_symlink():
            pending.append(f"sombra local não comprovada: {root}")
            continue
        if not root.is_dir():
            continue
        names = (sorted(p for p in root.iterdir() if p.name in package_skills)
                 if component == "skills" else [root])
        for path in names:
            rel = path.relative_to(project).as_posix()
            baseline = (old_repo / component / path.name if component == "skills"
                        else old_repo / component) if old_repo else None
            if baseline and tree_matches(path, baseline):
                if rel in authorized:
                    eligible.append(path)
                else:
                    pending.append(f"sombra local idêntica, requer opt-in --project/--reconcile-path {rel}")
            else:
                pending.append(f"sombra local editada/sem baseline (precedência local sobre global): {rel}")
    found = {p.relative_to(project).as_posix() for p in eligible}
    if set(authorized) != found:
        raise InstallError("Caminho local autorizado sem baseline idêntico ou fora do inventário: " + ", ".join(sorted(set(authorized) - found)))
    return pending, eligible


def launcher_text(data):
    return ("#!/bin/sh\n"
            f'exec {shlex.quote(str(data / "active/scripts/worktree-reservation"))} "$@"\n')


def inspect_launcher(home, data, env):
    """Check effective PATH and a separately recorded, byte-exact ownership."""
    binary = home / ".local/bin/worktree-reservation"
    record = data / "launcher.json"
    safe_parent(binary.parent, home)
    safe_parent(record, home)
    absent_or_regular(record)
    if binary.parent.is_symlink() or (binary.parent.exists() and not binary.parent.is_dir()):
        raise InstallError(f"Diretório de comando inseguro: {binary.parent}")
    paths = [Path(p or ".").absolute() for p in env.get("PATH", "").split(os.pathsep)]
    if binary.parent not in paths:
        raise InstallError(f"{binary.parent} fora do PATH; adicione-o ao PATH e repita.")
    first = shutil.which(binary.name, path=env.get("PATH"))
    if first and Path(first).absolute() != binary:
        raise InstallError(f"Comando de outra origem precede launcher no PATH: {first}")
    if record.exists():
        owned = json.loads(record.read_text())
        if (owned != {"schema": 1, "path": str(binary),
                      "sha256": hashlib.sha256(launcher_text(data).encode()).hexdigest(), "mode": 0o755}
                or binary.is_symlink() or not binary.is_file()
                or digest(binary) != owned["sha256"]
                or stat.S_IMODE(binary.stat().st_mode) != owned["mode"]):
            raise InstallError(f"Launcher alterado ou sem propriedade comprovada: {binary}")
    elif binary.exists() or binary.is_symlink():
        raise InstallError(f"Launcher sem registro de propriedade: {binary}")
    return binary, record


def install(args, *, source=ORIGIN):
    home = Path(os.environ["HOME"]).absolute()
    requested = sorted(set(args.agent or []))
    # Reject invalid explicit selections before any writes. Existing selection
    # is validated under the common lock before checking its retained runtimes.
    if requested:
        preflight(home, requested)
    data = Path(os.environ.get("XDG_DATA_HOME", str(home / ".local/share"))).absolute() / "my-ai-skills"
    safe_parent(data, home)
    if not requested and not (data / "active").is_symlink():
        preflight(home, [])
    if data.exists() and ((data / ".git").exists() or (data / ".git").is_file()):
        raise InstallError(f"Instalação antiga/clone no destino {data}; preserve-o e escolha outro XDG_DATA_HOME antes de instalar.")
    data.mkdir(parents=True, exist_ok=True)
    env = dict(os.environ)
    lock = data / ".install.lock"
    absent_or_regular(lock)
    with lock.open("a+b") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        with tempfile.TemporaryDirectory(prefix="workflow-source-") as directory:
            repo = fetch_snapshot(args.revision, source, Path(directory))
            manifest = manifest_for(repo, args.revision)
            versions = data / "versions"
            target = versions / args.revision
            active = data / "active"
            ownership = data / "guidance.json"
            launcher, launcher_record = inspect_launcher(home, data, env)
            safe_parent(versions, home)
            absent_or_regular(ownership)
            ownership_before = read_utf8(ownership) if ownership.exists() else None
            old_active = None
            prior = None
            old_manifest = None
            preserved_extras = []
            if active.is_symlink():
                old_active = os.readlink(active)
                resolved = (active.parent / old_active).resolve()
                if resolved.parent != versions.resolve() or not (resolved / "manifest.json").is_file():
                    raise InstallError("Ponteiro ativo não gerenciado.")
                old_manifest = json.loads((resolved / "manifest.json").read_text())
                preserved_extras = validate_manifest(
                    resolved, old_manifest, allow_extras=resolved != target)
                # A plausible self-declared manifest is not proof of ownership.
                prior = fetch_snapshot(old_manifest["revision"], source, Path(directory) / "prior")
                expected_old = manifest_for(prior, old_manifest["revision"], schema=old_manifest["schema"])
                if "directories" not in old_manifest:
                    expected_old.pop("directories")
                if old_manifest != expected_old:
                    raise InstallError("Ponteiro ativo sem origem verificável; preserve e reconcilie manualmente.")
            elif active.exists():
                raise InstallError("Ponteiro ativo de outra origem.")
            paths = integration_paths(home, env)
            previous_selection = installed_selection(
                json.loads(ownership_before) if ownership_before else None, prior, data, paths,
                old_manifest["revision"] if old_manifest else None)
            selection = sorted(set(previous_selection) | set(requested))
            preflight(home, selection)
            ensure_openspec(data, env)
            texts = []
            block = guidance(data)
            entries = {}
            for agent in selection:
                skills, instructions = paths[agent]
                for path in (skills, instructions):
                    safe_parent(path, home)
                absent_or_regular(instructions)
                previous = read_utf8(instructions) if instructions.exists() else None
                if agent not in previous_selection and previous and (BEGIN in previous or END in previous):
                    raise InstallError("Bloco global sem registro de propriedade; preserve e reconcilie manualmente.")
                new_text = updated_guidance(previous or "", block)
                texts.append((instructions, previous, new_text))
                entries[agent] = {"skills": str(skills), "instructions": str(instructions),
                                  "sha256": hashlib.sha256(block.rstrip("\n").encode()).hexdigest()}
            new_record = json.dumps({"schema": 2, "revision": args.revision, "agents": entries}, sort_keys=True) + "\n"
            if target.exists():
                if target.is_symlink() or not target.is_dir():
                    raise InstallError(f"Versão conflitante: {target}")
                old = json.loads((target / "manifest.json").read_text())
                validate_manifest(target, old)
                expected = manifest_for(repo, args.revision, schema=old.get("schema"))
                if "directories" not in old and old.get("schema") == 1:
                    expected.pop("directories")
                if old != expected:
                    raise InstallError(f"Manifesto conflitante: {target}")
            elif target.is_symlink():
                raise InstallError(f"Versão symlink conflitante: {target}")
            skill_names = sorted(p.name for p in (repo / "skills").iterdir() if (p / "SKILL.md").is_file())
            if "codex" in selection:
                inspect_codex(*paths["codex"], skill_names)
            lock_entries = skill_lock(home, env)
            legacy = []
            legacy_baselines = {}
            pending = []
            preserved = [f"entrada extra mantida na versão anterior (não migrada): {path}"
                         for path in preserved_extras]
            proven_links = set()
            if old_manifest:
                for agent in previous_selection:
                    inventory = old_manifest["integrations"].get(agent, old_manifest["integrations"]["opencode"])
                    proven_links.update(paths[agent][0] / Path(relative).name for relative in inventory["skills"])
            links = [(paths[agent][0] / name, name) for agent in selection
                     for name in sorted(set(skill_names) | set(lock_entries))]
            for link, name in links:
                expected = str(data / "active" / "skills" / name)
                if name not in skill_names:
                    managed_obsolete = link in proven_links and link.is_symlink() and os.readlink(link) == expected
                    if name in lock_entries and (link.exists() or link.is_symlink()) and not managed_obsolete:
                        preserved.append(f"skill skills.sh sem colisão (intocada): {link}")
                    continue
                if link.is_symlink() and os.readlink(link) == expected:
                    if link not in proven_links:
                        raise InstallError(f"Vínculo global sem ownership comprovado: {link}; preserve estado parcial e reconcilie explicitamente.")
                    continue
                if not link.exists() and not link.is_symlink():
                    continue
                entry = lock_entries.get(name)
                if name not in legacy_baselines:
                    legacy_baselines[name] = legacy_baseline(
                        name, entry, source, Path(directory) / ("legacy-" + name))
                baseline = legacy_baselines[name]
                proven = baseline is not None and legacy_matches(link, baseline, home)
                if not proven:
                    raise InstallError(f"blocked: skill global de outra origem, alterada ou sem baseline: {link}; "
                                       "preserve e compare metadados de ~/.agents/.skill-lock.json manualmente.")
                if name not in args.migrate_global_skill:
                    raise InstallError(f"blocked: skill global skills.sh comprovada: {link}; "
                                       f"para migrar, autorize --migrate-global-skill {name} e preserve o backup.")
                legacy.append((link, baseline))
            if set(args.migrate_global_skill) != {path.name for path, _ in legacy}:
                raise InstallError("Migração global autorizada sem entrada comprovada em conflito.")
            # skills.sh aliases may reference the universal Codex directory.
            # Move verified aliases first while their baseline still exists;
            # reverse-order rollback restores that directory before its aliases.
            legacy.sort(key=lambda item: not item[0].is_symlink())
            local_prior = prior
            if args.baseline_revision:
                local_prior = fetch_snapshot(args.baseline_revision, source, Path(directory) / "local-prior")
            local_pending, local_eligible = inspect_local(args.project, local_prior, repo, args.reconcile_path)
            pending.extend(local_pending)
            obsolete = []
            if old_active:
                for agent in previous_selection:
                    # Schema 1 inventory describes the same canonical skills.
                    inventory = old_manifest["integrations"].get(agent, old_manifest["integrations"]["opencode"])
                    for relative in inventory["skills"]:
                        name = Path(relative).name
                        link = paths[agent][0] / name
                        expected = str(data / "active" / "skills" / name)
                        if name in skill_names:
                            if not link.exists() and not link.is_symlink():
                                raise InstallError(f"Skill gerenciada ausente: {link}")
                            continue
                        if link.is_symlink() and os.readlink(link) == expected:
                            obsolete.append((link, expected))
                        elif link.exists() or link.is_symlink():
                            raise InstallError(f"Skill obsoleta personalizada: {link}")
                        else:
                            raise InstallError(f"Skill gerenciada ausente: {link}; estado anterior inconsistente.")
            for link, name in links:
                if name not in skill_names:
                    continue
                expected = str(data / "active" / "skills" / name)
                if link.is_symlink() and os.readlink(link) == expected:
                    continue
                if (link.exists() or link.is_symlink()) and name not in args.migrate_global_skill:
                    raise InstallError(f"Skill de outra origem/personalizada: {link}")
            # Refuse a cross-device move before moving *any* source. A rename
            # cannot atomically preserve and roll back backups across devices.
            migrations = [path for path, _ in legacy] + local_eligible
            backups = data / "migration-backups"
            if migrations:
                safe_parent(backups, home)
                if backups.is_symlink() or (backups.exists() and not backups.is_dir()):
                    raise InstallError(f"Diretório de backups inseguro: {backups}")
                backups.mkdir(exist_ok=True)
                safe_parent(backups, home)
                for path in migrations:
                    if path.parent.stat().st_dev != backups.stat().st_dev:
                        raise InstallError(f"Migração entre filesystems não suportada: {path}; nenhuma cópia movida")
            created = []
            removed = []
            published = False
            moved = []
            launcher_created = False
            launcher_record_created = False
            guidance_written = []
            for parent in (versions, *(paths[a][0] for a in selection),
                           *(paths[a][1].parent for a in selection)):
                safe_parent(parent, home)
                parent.mkdir(parents=True, exist_ok=True)
            try:
                if not target.exists():
                    with tempfile.TemporaryDirectory(prefix=".stage-", dir=versions) as stage:
                        staging = Path(stage) / "package"
                        staging.mkdir()
                        for component in COMPONENTS:
                            shutil.copytree(repo / component, staging / component, symlinks=False)
                        (staging / "manifest.json").write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
                        # The staged directory is not named after the revision yet.
                        validate_manifest(staging, manifest, staged=True)
                        staging.rename(target)
                        published = True
                for path, baseline in legacy + [(path, None) for path in local_eligible]:
                    if baseline is not None and not legacy_matches(path, baseline, home):
                        raise InstallError(f"Skill legada mudou durante a preparação: {path}")
                    if baseline is None:
                        # Recheck the exact local bytes after preparation.
                        remaining = set(args.reconcile_path) - {
                            moved_path.relative_to(Path(args.project).absolute()).as_posix()
                            for moved_path, _ in moved if moved_path in local_eligible
                        }
                        _, check_eligible = inspect_local(args.project, local_prior, repo, remaining)
                        if path not in check_eligible:
                            raise InstallError(f"Cópia local mudou durante a preparação: {path}")
                    safe_parent(backups, home)
                    if backups.is_symlink() or not backups.is_dir():
                        raise InstallError(f"Diretório de backups inseguro: {backups}")
                    backup = backups / (hashlib.sha256(str(path).encode()).hexdigest() + "-" + args.revision)
                    if backup.exists() or backup.is_symlink():
                        raise InstallError(f"Backup de migração já existe: {backup}")
                    try:
                        path.rename(backup)
                    except OSError as error:
                        if error.errno == errno.EXDEV:
                            raise InstallError(f"Migração entre filesystems recusada: {path}; backups anteriores revertidos") from error
                        raise
                    moved.append((path, backup))
                for link, name in links:
                    if name not in skill_names:
                        continue
                    safe_parent(link.parent, home)
                    expected = str(data / "active" / "skills" / name)
                    if not link.exists() and not link.is_symlink():
                        link.symlink_to(data / "active" / "skills" / name)
                        created.append(link)
                    elif not link.is_symlink() or os.readlink(link) != expected:
                        raise InstallError(f"Skill mudou durante a preparação: {link}")
                for link, expected in obsolete:
                    link.unlink()
                    removed.append((link, expected))
                if os.environ.get("MY_AI_SKILLS_FAIL_AT") == "skills":
                    raise InstallError("Falha simulada após registrar skills")
                for instructions, previous, new_text in texts:
                    safe_parent(instructions, home)
                    absent_or_regular(instructions)
                    if (read_utf8(instructions) if instructions.exists() else None) != previous:
                        raise InstallError(f"Orientação mudou durante a preparação: {instructions}")
                    if previous != new_text:
                        tmp = instructions.with_name(".AGENTS.md.install-tmp")
                        with tmp.open("x") as output:
                            output.write(new_text)
                        if instructions.exists():
                            tmp.chmod(stat.S_IMODE(instructions.stat().st_mode))
                        tmp.replace(instructions)
                        guidance_written.append((instructions, previous, new_text))
                absent_or_regular(ownership)
                if (read_utf8(ownership) if ownership.exists() else None) != ownership_before:
                    raise InstallError("Registro global mudou durante a preparação.")
                if ownership_before != new_record:
                    tmp = ownership.with_name(".guidance.json.install-tmp")
                    if tmp.exists() or tmp.is_symlink():
                        raise InstallError(f"Arquivo temporário conflitante: {tmp}")
                    with tmp.open("x") as output:
                        output.write(new_record)
                    tmp.replace(ownership)
                if os.environ.get("MY_AI_SKILLS_FAIL_AT") == "guidance":
                    raise InstallError("Falha simulada após orientação")
                # Prepare only after snapshot validation. Never replace an
                # unowned or altered command, including on idempotent updates.
                inspect_launcher(home, data, env)
                if not launcher_record.exists():
                    launcher.parent.mkdir(parents=True, exist_ok=True)
                    with launcher.open("x") as output:
                        launcher_created = True
                        output.write(launcher_text(data))
                    launcher.chmod(0o755)
                    with launcher_record.open("x") as output:
                        launcher_record_created = True
                        output.write(json.dumps({
                            "schema": 1, "path": str(launcher),
                            "sha256": digest(launcher), "mode": 0o755}) + "\n")
                if os.environ.get("MY_AI_SKILLS_FAIL_AT") == "launcher":
                    raise InstallError("Falha simulada após launcher")
                if os.environ.get("MY_AI_SKILLS_FAIL_AT") == "publish":
                    raise InstallError("Falha simulada antes da publicação")
                if ((os.readlink(active) if active.is_symlink() else None) != old_active
                        or (not active.is_symlink() and active.exists())):
                    raise InstallError("Ponteiro ativo mudou durante a preparação; não substituir.")
                if old_active != str(Path("versions") / args.revision):
                    pointer = data / ".active.install-tmp"
                    if pointer.exists() or pointer.is_symlink():
                        raise InstallError(f"Ponteiro temporário conflitante: {pointer}")
                    pointer.symlink_to(Path("versions") / args.revision)
                    pointer.replace(active)
            except Exception:
                expected_launcher_record = {"schema": 1, "path": str(launcher),
                                            "sha256": hashlib.sha256(launcher_text(data).encode()).hexdigest(),
                                            "mode": 0o755}
                if (launcher_record_created and not launcher_record.is_symlink()
                        and launcher_record.is_file()
                        and json.loads(read_utf8(launcher_record)) == expected_launcher_record):
                    launcher_record.unlink()
                if (launcher_created and not launcher.is_symlink() and launcher.is_file()
                        and launcher.read_bytes() == launcher_text(data).encode()
                        and stat.S_IMODE(launcher.stat().st_mode) == 0o755):
                    launcher.unlink()
                if (not ownership.is_symlink() and ownership.is_file()
                        and read_utf8(ownership) == new_record and new_record != ownership_before):
                    if ownership_before is None:
                        ownership.unlink()
                    else:
                        ownership.write_text(ownership_before)
                for instructions, previous, new_text in reversed(guidance_written):
                    if not instructions.is_symlink() and instructions.is_file() and read_utf8(instructions) == new_text:
                        if previous is not None:
                            instructions.write_text(previous)
                        else:
                            instructions.unlink()
                for link in created:
                    if link.is_symlink() and os.readlink(link) == str(data / "active/skills" / link.name):
                        link.unlink()
                for link, expected in removed:
                    if not link.exists() and not link.is_symlink():
                        link.symlink_to(expected)
                for path, backup in reversed(moved):
                    if not path.exists() and not path.is_symlink() and backup.exists():
                        backup.rename(path)
                if published:
                    # Keep immutable staged versions for diagnosis; never remove unknown paths.
                    pass
                raise
            final = json.loads((active / "manifest.json").read_text())["revision"]
            state = ("partial" if pending else "installed" if not old_manifest else "already current" if
                     old_manifest["revision"] == final and not moved and not created and not removed
                      and all(previous == new_text for _, previous, new_text in texts)
                      and ownership_before == new_record else "updated")
            print(f"state={state} agent={','.join(selection)} scope=global previous={old_manifest['revision'] if old_manifest else 'none'} "
                  f"target={args.revision} active={final}")
            for item in pending:
                print(f"pending: {item}")
            for item in preserved:
                print(f"preserved: {item}")
            for path, backup in moved:
                print(f"migrated: {path} backup={backup}")
            print(f"Verifique: {data}/active/manifest.json; OpenSpec: {shutil.which('openspec')}")


def main():
    parser = argparse.ArgumentParser(description="Instalação global do AI Engineering Workflow")
    parser.add_argument("--agent", action="append", default=[], help="opencode ou codex; repetível, update preserva seleção")
    parser.add_argument("--revision", required=True, help="SHA completo aprovado")
    parser.add_argument("--project", help="Raiz única do projeto para diagnóstico somente leitura")
    parser.add_argument("--baseline-revision", help="SHA completo da origem das cópias locais antigas")
    parser.add_argument("--reconcile-path", action="append", default=[], help="Caminho relativo local autorizado separadamente (requer --project)")
    parser.add_argument("--migrate-global-skill", action="append", default=[], help="Skill global legada comprovada autorizada para migração com backup")
    args = parser.parse_args()
    if not re.fullmatch(r"[0-9a-f]{40}", args.revision):
        parser.error("--revision exige SHA Git completo de 40 caracteres")
    if args.baseline_revision and not re.fullmatch(r"[0-9a-f]{40}", args.baseline_revision):
        parser.error("--baseline-revision exige SHA Git completo de 40 caracteres")
    try:
        install(args)
    except (InstallError, OSError, ValueError, KeyError) as error:
        home = Path(os.environ["HOME"])
        active = Path(os.environ.get("XDG_DATA_HOME", str(home / ".local/share"))) / "my-ai-skills/active/manifest.json"
        try:
            actual = json.loads(active.read_text())["revision"] if active.is_file() else "none"
        except (ValueError, KeyError, OSError):
            actual = "unknown"
        print(f"state=blocked agent={','.join(args.agent)} scope=global previous={actual} "
              f"target={args.revision} active={actual}; pending: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
