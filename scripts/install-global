#!/usr/bin/env python3
"""Install a Git-verified workflow snapshot for explicitly selected agents.

The public command MUST verify this entrypoint's independently published SHA-256
before running it. --revision binds the fetched Git object to that entrypoint.
"""
import argparse
import errno
import fcntl
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import urllib.request

ORIGIN = "https://github.com/rocker-code/my-ai-skills.git"
OPENSPEC_INSTALL_REVISION = "a959be77cf045ea3156dc5089c9e2f1d6ce9ce70"
OPENSPEC_INSTALL_SHA256 = "fa5e08b9cec6815e69cd5fc250fc57aa720609927da38587f872e2e74f9ec09b"
BEGIN = "<!-- my-ai-skills-global:v1 begin -->"
END = "<!-- my-ai-skills-global:v1 end -->"
COMPONENTS = ("skills", "protocol", "templates", "scripts")


class InstallError(Exception):
    pass


def run(*argv, cwd=None, env=None):
    result = subprocess.run(argv, cwd=cwd, env=env, text=True, capture_output=True)
    if result.returncode:
        raise InstallError(f"{' '.join(map(str, argv))}: {result.stderr.strip() or result.stdout.strip()}")
    return result.stdout.strip()


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def absent_or_regular(path):
    if path.is_symlink() or (path.exists() and not path.is_file()):
        raise InstallError(f"Caminho inseguro ou de outra origem: {path}")


def safe_parent(path, stop):
    for ancestor in (path, *path.parents):
        if ancestor == stop.parent:
            break
        if ancestor.is_symlink():
            raise InstallError(f"Diretório symlink não confiável: {ancestor}")


def preflight(home, agents):
    if not agents or set(agents) != {"opencode"}:
        raise InstallError("Selecione --agent opencode (único agente suportado).")
    if os.name != "posix" or platform.system() not in ("Linux", "Darwin"):
        raise InstallError("Plataforma não suportada: use Linux ou macOS POSIX.")
    if sys.version_info < (3, 10):
        raise InstallError("Python 3.10+ necessário; instale-o antes de continuar.")
    for executable in ("git", "gh", "jq", "curl", "opencode"):
        if not shutil.which(executable):
            raise InstallError(f"Falta {executable} no PATH; instale-o antes de continuar.")
    opencode = shutil.which("opencode")
    version = run(opencode, "--version")
    help_text = run(opencode, "--help")
    if not re.search(r"\bv2\.\d+\.\d+\b", version) or not all(
        re.search(r"^ *" + token + r"\b", help_text, re.MULTILINE)
        for token in ("api", "run", "service")
    ):
        raise InstallError("OpenCode V2 com API, run e service é necessário; instale/atualize OpenCode V2.")
    if not home.is_dir():
        raise InstallError(f"HOME inválido: {home}")


def ensure_openspec(data, env):
    existing = shutil.which("openspec", path=env.get("PATH"))
    if existing:
        run(existing, "--version", env=env)
        return existing
    # The upstream standalone installer checks the released binary against
    # SHA256SUMS. It is used only when no existing method owns this tool.
    with tempfile.TemporaryDirectory(prefix="openspec-install-") as temp:
        script = Path(temp) / "install.sh"
        run("curl", "-fsSL", f"https://raw.githubusercontent.com/Fission-AI/OpenSpec/{OPENSPEC_INSTALL_REVISION}/scripts/binary/install.sh", "-o", str(script), env=env)
        if digest(script) != OPENSPEC_INSTALL_SHA256:
            raise InstallError("Digest do instalador OpenSpec divergente; não executar.")
        target = data / "bin"
        target.mkdir(parents=True, exist_ok=True)
        installer_env = {**env, "OPENSPEC_INSTALL_DIR": str(target)}
        run("bash", str(script), env=installer_env)
        binary = target / "openspec"
        if not binary.is_file():
            raise InstallError("OpenSpec standalone não foi instalado; consulte https://github.com/Fission-AI/OpenSpec/blob/main/docs/installation.md")
        run(str(binary), "--version", env=env)
        if shutil.which("openspec", path=env.get("PATH")) != str(binary):
            raise InstallError(f"OpenSpec instalado em {binary}, mas fora do PATH. Adicione {target} ao PATH e repita.")
        return str(binary)


def fetch_snapshot(revision, source, temp):
    repo = temp / "source"
    run("git", "init", "-q", str(repo))
    run("git", "-C", str(repo), "remote", "add", "origin", source)
    run("git", "-C", str(repo), "fetch", "-q", "--depth", "1", "origin", revision)
    fetched = run("git", "-C", str(repo), "rev-parse", "FETCH_HEAD^{commit}")
    if fetched != revision:
        raise InstallError("Snapshot não corresponde ao SHA aprovado.")
    run("git", "-C", str(repo), "checkout", "-q", "--detach", revision)
    if run("git", "-C", str(repo), "rev-parse", "HEAD") != revision:
        raise InstallError("Revisão do checkout divergente.")
    run("git", "-C", str(repo), "fsck", "--no-reflogs", "--connectivity-only")
    for component in COMPONENTS:
        if (repo / component).is_symlink() or not (repo / component).is_dir():
            raise InstallError(f"Snapshot incompleto: {component}")
    if not (repo / "scripts" / "sync-skill-references").is_file():
        raise InstallError("Snapshot sem gerador independente de referências.")
    return repo


def manifest_for(root, revision, agents):
    entries = {}
    directories = {}
    skills = sorted(p.name for p in (root / "skills").iterdir() if (p / "SKILL.md").is_file())
    for component in COMPONENTS:
        directories[component] = stat.S_IMODE((root / component).stat().st_mode)
        for path in (root / component).rglob("*"):
            if path.is_symlink():
                raise InstallError(f"Symlink inesperado no snapshot: {path}")
            if path.is_file():
                relative = path.relative_to(root).as_posix()
                entries[relative] = {"sha256": digest(path), "mode": stat.S_IMODE(path.stat().st_mode)}
            elif path.is_dir():
                directories[path.relative_to(root).as_posix()] = stat.S_IMODE(path.stat().st_mode)
    for name in ("worktree-reservation", "workflow-evidence", "workflow-event"):
        if f"scripts/{name}" not in entries:
            raise InstallError(f"Helper ausente: {name}")
    return {"schema": 1, "origin": ORIGIN, "revision": revision,
            "agents": sorted(set(agents)), "files": entries, "directories": directories,
            "integrations": {"opencode": {"skills": ["skills/" + name for name in skills],
                                        "instructions": "AGENTS.md", "ownership": "guidance.json"}}}


def validate_manifest(root, manifest, staged=False, allow_extras=False):
    if (not isinstance(manifest, dict) or manifest.get("schema") != 1
            or manifest.get("origin") != ORIGIN
            or not re.fullmatch(r"[0-9a-f]{40}", manifest.get("revision", ""))
            or (not staged and root.name != manifest["revision"])
            or manifest.get("agents") != ["opencode"]
            or not isinstance(manifest.get("files"), dict) or not manifest["files"]
            or not isinstance(manifest.get("integrations"), dict)):
        raise InstallError(f"Manifesto sem propriedade comprovada: {root}")
    actual = set()
    actual_dirs = set()
    for directory, dirs, files in os.walk(root, followlinks=False):
        for name in dirs + files:
            path = Path(directory) / name
            if path.is_symlink() or (not path.is_dir() and not path.is_file()):
                raise InstallError(f"Entrada inesperada no pacote: {path}")
            if path.is_file():
                actual.add(path.relative_to(root).as_posix())
            else:
                actual_dirs.add(path.relative_to(root).as_posix())
    expected = set(manifest["files"]) | {"manifest.json"}
    missing = expected - actual
    if missing:
        raise InstallError("Arquivos gerenciados ausentes: " + ", ".join(str(root / p) for p in sorted(missing)))
    expected_dirs = manifest.get("directories")
    if expected_dirs is None:  # Legacy manifest from the previously published entrypoint.
        expected_dirs = {parent for item in manifest["files"] for parent in (
            Path(item).parents) if str(parent) != "."}
        expected_dirs = {str(parent) for parent in expected_dirs}
    missing_dirs = set(expected_dirs) - actual_dirs
    if missing_dirs:
        raise InstallError("Diretórios gerenciados ausentes: " + ", ".join(str(root / p) for p in sorted(missing_dirs)))
    extras = (actual - expected) | (actual_dirs - set(expected_dirs))
    # Only untracked cache entries are disposable; managed files always retain
    # their hash/mode validation, even if their name resembles a cache.
    def cache(relative):
        path = Path(relative)
        return "__pycache__" in path.parts or path.suffix in {".pyc", ".pyo"}
    unknown = sorted(p for p in extras if staged or not cache(p))
    if unknown and not allow_extras:
        raise InstallError("Entradas extras no pacote: " + ", ".join(str(root / p) for p in unknown))
    if isinstance(expected_dirs, dict):
        for relative, mode in expected_dirs.items():
            if not isinstance(mode, int) or stat.S_IMODE((root / relative).stat().st_mode) != mode:
                raise InstallError(f"Diretório gerenciado modificado: {root / relative}")
    for relative, info in manifest["files"].items():
        path = root / relative
        if (relative.split("/", 1)[0] not in COMPONENTS or Path(relative).is_absolute()
                or ".." in Path(relative).parts or not isinstance(info, dict)
                or not re.fullmatch(r"[0-9a-f]{64}", info.get("sha256", ""))
                or not isinstance(info.get("mode"), int)
                or not path.is_file() or path.is_symlink() or digest(path) != info["sha256"]
                or stat.S_IMODE(path.stat().st_mode) != info["mode"]):
            raise InstallError(f"Arquivo gerenciado modificado: {path}")
    if not (root / "manifest.json").is_file() or json.loads((root / "manifest.json").read_text()) != manifest:
        raise InstallError(f"Manifesto divergente: {root}")

    return [str(root / p) for p in unknown]


def guidance(data):
    return f"""{BEGIN}
AI Engineering Workflow global: pacote em {data}/active (skills/, protocol/,
templates/, scripts/). Use helpers por caminho absoluto, por exemplo
{data}/active/scripts/worktree-reservation; cite argumentos e caminhos com espaços.
Referências nas skills são relativas ao pacote global, nunca ao projeto atual.
Regras locais AGENTS.md e instruções do usuário, especialmente restrições mais
fortes, prevalecem; nenhuma permissão ou execução é concedida por este bloco.
Estado, reservas, logs e evidências continuam no Git common dir do checkout.

OpenSpec no primeiro uso: antes de propor/aplicar, confira `openspec context --json`
e `openspec list --json` no root pretendido e os arquivos REAIS do perfil
OpenCode: .opencode/commands/opsx-{{explore,propose,apply,archive}}.md e
.opencode/skills/openspec-explore/SKILL.md,
.opencode/skills/openspec-propose/SKILL.md,
.opencode/skills/openspec-apply-change/SKILL.md e
.opencode/skills/openspec-archive-change/SKILL.md (considere também o perfil
configurado e todos os comandos/skills que ele exige).
Não execute init/update durante instalação global nem sem autorização.
Novo projeto: confirme root e inventarie resíduos .opencode/, .agents/,
.claude/, instruções marcadas e prompts opsx-* no HOME; se houver impacto,
peça aprovação explícita antes de `openspec init --tools opencode`.
Projeto existente completo: use como está. Incompleto: inspecione
`openspec update --dry-run --json`, ferramentas configuradas, diferenças,
arquivos customizados e efeitos globais antes de pedir autorização para update.
Se OpenCode não estiver configurado, só proponha `openspec init --tools`
com união explícita de ferramentas existentes + opencode após aprovar qualquer
limpeza; sem preservação garantida, bloqueie sem escrever. Nunca use --force.
Compare config/specs/changes antes e depois. Abra sessão OpenCode NOVA e
comprove descoberta/invocação dos quatro comandos /opsx-* e skills oficiais;
sem essa prova reporte bloqueio, não declare bootstrap concluído.
{END}
"""


def updated_guidance(existing, block):
    if BEGIN in existing or END in existing:
        if existing.count(BEGIN) != 1 or existing.count(END) != 1 or existing.index(BEGIN) > existing.index(END):
            raise InstallError("Bloco AGENTS.md alterado/inconsistente; não substituir.")
        start = existing.index(BEGIN)
        finish = existing.index(END) + len(END)
        # Preserve all content outside the managed block byte-for-byte.
        return existing[:start] + block.rstrip("\n") + existing[finish:]
    return existing + ("\n" if existing and not existing.endswith("\n") else "") + block


def tree_matches(actual, baseline):
    """Compare all bytes, modes and directory entries; never follow symlinks."""
    if actual.is_symlink() or not actual.is_dir() or not baseline.is_dir():
        return False
    def entries(root):
        result = {}
        for directory, dirs, files in os.walk(root, followlinks=False):
            for name in dirs + files:
                path = Path(directory) / name
                if path.is_symlink():
                    return None
                key = path.relative_to(root).as_posix()
                result[key] = ("dir" if path.is_dir() else "file",
                               stat.S_IMODE(path.stat().st_mode),
                               digest(path) if path.is_file() else None)
        return result
    return (stat.S_IMODE(actual.stat().st_mode) == stat.S_IMODE(baseline.stat().st_mode)
            and entries(actual) == entries(baseline))


def legacy_matches(path, baseline, home):
    if path.is_symlink():
        # skills.sh commonly links an agent directory to its universal copy.
        canonical = home / ".agents/skills" / path.name
        if path.resolve() != canonical.absolute() or canonical.is_symlink():
            return False
        return tree_matches(canonical, baseline)
    return tree_matches(path, baseline)


def skill_lock(home, env):
    state = Path(env.get("XDG_STATE_HOME", str(home / ".agents")))
    path = state / "skills/.skill-lock.json" if "XDG_STATE_HOME" in env else state / ".skill-lock.json"
    if not path.is_file() or path.is_symlink():
        return {}
    try:
        lock = json.loads(path.read_text())
        return lock["skills"] if isinstance(lock.get("skills"), dict) else {}
    except (ValueError, KeyError):
        return {}


def legacy_baseline(name, entry, source, temp):
    if (not isinstance(entry, dict) or entry.get("source") != "rocker-code/my-ai-skills"
            or entry.get("sourceType") != "github"
            or not re.fullmatch(r"[0-9a-f]{40}", entry.get("ref", ""))
            or entry.get("skillPath") not in (f"skills/{name}", f"skills/{name}/SKILL.md")):
        return None
    try:
        return fetch_snapshot(entry["ref"], source, temp) / "skills" / name
    except InstallError:
        return None


def inspect_local(project, old_repo, new_repo, authorized):
    """Only paths under the explicitly identified root; return planned safe removals."""
    if project is None:
        if authorized:
            raise InstallError("--reconcile-path exige --project explícito.")
        return [], []
    if ".." in Path(project).parts:
        raise InstallError(f"Projeto com percurso ambíguo: {project}")
    project = Path(project).absolute()
    # Authorization is for this physical root, never a lexical path through
    # another project's symlink (including the root's parent).
    safe_parent(project, Path(project.anchor))
    if project.resolve() != project:
        raise InstallError(f"Projeto fora da raiz canônica autorizada: {project}")
    if project.is_symlink() or not project.is_dir():
        raise InstallError(f"Projeto inválido: {project}")
    pending, eligible = [], []
    roots = {".opencode/skills": "skills", ".ai-workflow/skills": "skills",
             ".ai-workflow/protocol": "protocol", ".ai-workflow/templates": "templates",
              ".ai-workflow/scripts": "scripts"}
    package_skills = {item.name for item in (new_repo / "skills").iterdir()
                      if (item / "SKILL.md").is_file()}
    for prefix, component in roots.items():
        root = project / prefix
        safe_parent(root, project)
        if root.is_symlink():
            pending.append(f"sombra local não comprovada: {root}")
            continue
        if not root.is_dir():
            continue
        names = (sorted(p for p in root.iterdir() if p.name in package_skills)
                 if component == "skills" else [root])
        for path in names:
            rel = path.relative_to(project).as_posix()
            baseline = (old_repo / component / path.name if component == "skills"
                        else old_repo / component) if old_repo else None
            if baseline and tree_matches(path, baseline):
                if rel in authorized:
                    eligible.append(path)
                else:
                    pending.append(f"sombra local idêntica, requer opt-in --project/--reconcile-path {rel}")
            else:
                pending.append(f"sombra local editada/sem baseline (precedência local sobre global): {rel}")
    found = {p.relative_to(project).as_posix() for p in eligible}
    if set(authorized) != found:
        raise InstallError("Caminho local autorizado sem baseline idêntico ou fora do inventário: " + ", ".join(sorted(set(authorized) - found)))
    return pending, eligible


def install(args, *, source=ORIGIN):
    home = Path(os.environ["HOME"]).absolute()
    preflight(home, args.agent)
    data = Path(os.environ.get("XDG_DATA_HOME", str(home / ".local/share"))).absolute() / "my-ai-skills"
    config = Path(os.environ.get("XDG_CONFIG_HOME", str(home / ".config"))).absolute() / "opencode"
    safe_parent(data, home)
    safe_parent(config, home)
    if data.exists() and ((data / ".git").exists() or (data / ".git").is_file()):
        raise InstallError(f"Instalação antiga/clone no destino {data}; preserve-o e escolha outro XDG_DATA_HOME antes de instalar.")
    data.mkdir(parents=True, exist_ok=True)
    env = dict(os.environ)
    ensure_openspec(data, env)
    lock = data / ".install.lock"
    absent_or_regular(lock)
    with lock.open("a+b") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        with tempfile.TemporaryDirectory(prefix="workflow-source-") as directory:
            repo = fetch_snapshot(args.revision, source, Path(directory))
            manifest = manifest_for(repo, args.revision, args.agent)
            versions = data / "versions"
            target = versions / args.revision
            active = data / "active"
            skills = config / "skills"
            agents = config / "AGENTS.md"
            ownership = data / "guidance.json"
            for parent in (versions, config, skills):
                safe_parent(parent, home)
                parent.mkdir(parents=True, exist_ok=True)
            absent_or_regular(agents)
            absent_or_regular(ownership)
            previous = agents.read_text() if agents.exists() else ""
            ownership_before = ownership.read_text() if ownership.exists() else None
            if BEGIN in previous or END in previous:
                if not ownership_before:
                    raise InstallError("Bloco global sem registro de propriedade; preserve e reconcilie manualmente.")
                record = json.loads(ownership_before)
                if record.get("sha256") != hashlib.sha256(previous[previous.index(BEGIN):previous.index(END) + len(END)].encode()).hexdigest():
                    raise InstallError("Orientação global personalizada; não sobrescrever.")
            elif ownership_before:
                raise InstallError("Registro global existe, mas orientação foi removida.")
            new_text = updated_guidance(previous, guidance(data))
            new_record = json.dumps({"schema": 1, "sha256": hashlib.sha256(guidance(data).rstrip("\n").encode()).hexdigest()}) + "\n"
            if target.exists():
                if target.is_symlink() or not target.is_dir():
                    raise InstallError(f"Versão conflitante: {target}")
                old = json.loads((target / "manifest.json").read_text())
                if old != manifest:
                    raise InstallError(f"Manifesto conflitante: {target}")
                validate_manifest(target, old)
            elif target.is_symlink():
                raise InstallError(f"Versão symlink conflitante: {target}")
            old_active = None
            prior = None
            old_manifest = None
            preserved_extras = []
            if active.is_symlink():
                old_active = os.readlink(active)
                resolved = (active.parent / old_active).resolve()
                if resolved.parent != versions.resolve() or not (resolved / "manifest.json").is_file():
                    raise InstallError("Ponteiro ativo não gerenciado.")
                old_manifest = json.loads((resolved / "manifest.json").read_text())
                preserved_extras = validate_manifest(
                    resolved, old_manifest, allow_extras=resolved != target)
                # A plausible self-declared manifest is not proof of ownership.
                prior = fetch_snapshot(old_manifest["revision"], source, Path(directory) / "prior")
                expected_old = manifest_for(prior, old_manifest["revision"], ["opencode"])
                if "directories" not in old_manifest:
                    expected_old.pop("directories")
                if old_manifest != expected_old:
                    raise InstallError("Ponteiro ativo sem origem verificável; preserve e reconcilie manualmente.")
            elif active.exists():
                raise InstallError("Ponteiro ativo de outra origem.")
            skill_names = sorted(p.name for p in (repo / "skills").iterdir() if (p / "SKILL.md").is_file())
            lock_entries = skill_lock(home, env)
            legacy = []
            pending = []
            preserved = [f"entrada extra mantida na versão anterior (não migrada): {path}"
                         for path in preserved_extras]
            for name in sorted(set(skill_names) | set(lock_entries)):
                link = skills / name
                if name not in skill_names:
                    if name in lock_entries and (link.exists() or link.is_symlink()):
                        preserved.append(f"skill skills.sh sem colisão (intocada): {link}")
                    continue
                expected = str(data / "active" / "skills" / name)
                if link.is_symlink() and os.readlink(link) == expected:
                    continue
                if not link.exists() and not link.is_symlink():
                    continue
                entry = lock_entries.get(name)
                baseline = legacy_baseline(name, entry, source, Path(directory) / ("legacy-" + name))
                proven = baseline is not None and legacy_matches(link, baseline, home)
                if not proven:
                    raise InstallError(f"blocked: skill global de outra origem, alterada ou sem baseline: {link}; "
                                       "preserve e compare metadados de ~/.agents/.skill-lock.json manualmente.")
                if name not in args.migrate_global_skill:
                    raise InstallError(f"blocked: skill global skills.sh comprovada: {link}; "
                                       f"para migrar, autorize --migrate-global-skill {name} e preserve o backup.")
                legacy.append((link, baseline))
            if set(args.migrate_global_skill) != {path.name for path, _ in legacy}:
                raise InstallError("Migração global autorizada sem entrada comprovada em conflito.")
            local_prior = prior
            if args.baseline_revision:
                local_prior = fetch_snapshot(args.baseline_revision, source, Path(directory) / "local-prior")
            local_pending, local_eligible = inspect_local(args.project, local_prior, repo, args.reconcile_path)
            pending.extend(local_pending)
            obsolete = []
            if old_active:
                for relative in old_manifest["integrations"]["opencode"]["skills"]:
                    name = Path(relative).name
                    if name not in skill_names:
                        link = skills / name
                        expected = str(data / "active" / "skills" / name)
                        if link.is_symlink() and os.readlink(link) == expected:
                            obsolete.append((link, expected))
                        elif link.exists() or link.is_symlink():
                            raise InstallError(f"Skill obsoleta personalizada: {link}")
            for name in skill_names:
                link = skills / name
                expected = str(data / "active" / "skills" / name)
                if link.is_symlink() and os.readlink(link) == expected:
                    continue
                if (link.exists() or link.is_symlink()) and name not in args.migrate_global_skill:
                    raise InstallError(f"Skill de outra origem/personalizada: {link}")
            # Refuse a cross-device move before moving *any* source. A rename
            # cannot atomically preserve and roll back backups across devices.
            migrations = [path for path, _ in legacy] + local_eligible
            backups = data / "migration-backups"
            if migrations:
                safe_parent(backups, home)
                if backups.is_symlink() or (backups.exists() and not backups.is_dir()):
                    raise InstallError(f"Diretório de backups inseguro: {backups}")
                backups.mkdir(exist_ok=True)
                safe_parent(backups, home)
                for path in migrations:
                    if path.parent.stat().st_dev != backups.stat().st_dev:
                        raise InstallError(f"Migração entre filesystems não suportada: {path}; nenhuma cópia movida")
            created = []
            removed = []
            published = False
            moved = []
            try:
                if not target.exists():
                    with tempfile.TemporaryDirectory(prefix=".stage-", dir=versions) as stage:
                        staging = Path(stage) / "package"
                        staging.mkdir()
                        for component in COMPONENTS:
                            shutil.copytree(repo / component, staging / component, symlinks=False)
                        (staging / "manifest.json").write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
                        # The staged directory is not named after the revision yet.
                        validate_manifest(staging, manifest, staged=True)
                        staging.rename(target)
                        published = True
                for path, baseline in legacy + [(path, None) for path in local_eligible]:
                    if baseline is not None and not legacy_matches(path, baseline, home):
                        raise InstallError(f"Skill legada mudou durante a preparação: {path}")
                    if baseline is None:
                        # Recheck the exact local bytes after preparation.
                        remaining = set(args.reconcile_path) - {
                            moved_path.relative_to(Path(args.project).absolute()).as_posix()
                            for moved_path, _ in moved if moved_path in local_eligible
                        }
                        _, check_eligible = inspect_local(args.project, local_prior, repo, remaining)
                        if path not in check_eligible:
                            raise InstallError(f"Cópia local mudou durante a preparação: {path}")
                    safe_parent(backups, home)
                    if backups.is_symlink() or not backups.is_dir():
                        raise InstallError(f"Diretório de backups inseguro: {backups}")
                    backup = backups / (hashlib.sha256(str(path).encode()).hexdigest() + "-" + args.revision)
                    if backup.exists() or backup.is_symlink():
                        raise InstallError(f"Backup de migração já existe: {backup}")
                    try:
                        path.rename(backup)
                    except OSError as error:
                        if error.errno == errno.EXDEV:
                            raise InstallError(f"Migração entre filesystems recusada: {path}; backups anteriores revertidos") from error
                        raise
                    moved.append((path, backup))
                for name in skill_names:
                    link = skills / name
                    if not link.is_symlink():
                        link.symlink_to(data / "active" / "skills" / name)
                        created.append(link)
                for link, expected in obsolete:
                    link.unlink()
                    removed.append((link, expected))
                if os.environ.get("MY_AI_SKILLS_FAIL_AT") == "skills":
                    raise InstallError("Falha simulada após registrar skills")
                if previous != new_text:
                    tmp = agents.with_name(".AGENTS.md.install-tmp")
                    if tmp.exists() or tmp.is_symlink():
                        raise InstallError(f"Arquivo temporário conflitante: {tmp}")
                    tmp.write_text(new_text)
                    tmp.replace(agents)
                if ownership_before != new_record:
                    tmp = ownership.with_name(".guidance.json.install-tmp")
                    if tmp.exists() or tmp.is_symlink():
                        raise InstallError(f"Arquivo temporário conflitante: {tmp}")
                    tmp.write_text(new_record)
                    tmp.replace(ownership)
                if os.environ.get("MY_AI_SKILLS_FAIL_AT") == "guidance":
                    raise InstallError("Falha simulada após orientação")
                if os.environ.get("MY_AI_SKILLS_FAIL_AT") == "publish":
                    raise InstallError("Falha simulada antes da publicação")
                if old_active != str(Path("versions") / args.revision):
                    pointer = data / ".active.install-tmp"
                    if pointer.exists() or pointer.is_symlink():
                        raise InstallError(f"Ponteiro temporário conflitante: {pointer}")
                    pointer.symlink_to(Path("versions") / args.revision)
                    pointer.replace(active)
            except Exception:
                if ownership.exists() and ownership.read_text() == new_record and new_record != ownership_before:
                    if ownership_before is None:
                        ownership.unlink()
                    else:
                        ownership.write_text(ownership_before)
                if agents.exists() and agents.read_text() == new_text and new_text != previous:
                    if previous:
                        agents.write_text(previous)
                    else:
                        agents.unlink()
                for link in created:
                    link.unlink()
                for link, expected in removed:
                    if not link.exists() and not link.is_symlink():
                        link.symlink_to(expected)
                for path, backup in reversed(moved):
                    if not path.exists() and not path.is_symlink() and backup.exists():
                        backup.rename(path)
                if published:
                    # Keep immutable staged versions for diagnosis; never remove unknown paths.
                    pass
                raise
            final = json.loads((active / "manifest.json").read_text())["revision"]
            state = ("partial" if pending else "installed" if not old_manifest else "already current" if
                     old_manifest["revision"] == final and not moved and not created and not removed
                     and previous == new_text else "updated")
            print(f"state={state} agent=opencode scope=global previous={old_manifest['revision'] if old_manifest else 'none'} "
                  f"target={args.revision} active={final}")
            for item in pending:
                print(f"pending: {item}")
            for item in preserved:
                print(f"preserved: {item}")
            for path, backup in moved:
                print(f"migrated: {path} backup={backup}")
            print(f"Verifique: {data}/active/manifest.json; OpenSpec: {shutil.which('openspec')}")


def main():
    parser = argparse.ArgumentParser(description="Instalação global do AI Engineering Workflow")
    parser.add_argument("--agent", action="append", required=True, help="opencode")
    parser.add_argument("--revision", required=True, help="SHA completo aprovado")
    parser.add_argument("--project", help="Raiz única do projeto para diagnóstico somente leitura")
    parser.add_argument("--baseline-revision", help="SHA completo da origem das cópias locais antigas")
    parser.add_argument("--reconcile-path", action="append", default=[], help="Caminho relativo local autorizado separadamente (requer --project)")
    parser.add_argument("--migrate-global-skill", action="append", default=[], help="Skill global legada comprovada autorizada para migração com backup")
    args = parser.parse_args()
    if not re.fullmatch(r"[0-9a-f]{40}", args.revision):
        parser.error("--revision exige SHA Git completo de 40 caracteres")
    if args.baseline_revision and not re.fullmatch(r"[0-9a-f]{40}", args.baseline_revision):
        parser.error("--baseline-revision exige SHA Git completo de 40 caracteres")
    try:
        install(args)
    except (InstallError, OSError, ValueError, KeyError) as error:
        home = Path(os.environ["HOME"])
        active = Path(os.environ.get("XDG_DATA_HOME", str(home / ".local/share"))) / "my-ai-skills/active/manifest.json"
        try:
            actual = json.loads(active.read_text())["revision"] if active.is_file() else "none"
        except (ValueError, KeyError, OSError):
            actual = "unknown"
        print(f"state=blocked agent={','.join(args.agent)} scope=global previous={actual} "
              f"target={args.revision} active={actual}; pending: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
