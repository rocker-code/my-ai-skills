#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
plugin_root="$repo_root/plugins/my-ai-skills"

[[ -f "$plugin_root/.codex-plugin/plugin.json" ]] || {
  echo "error: plugin scaffold not found at $plugin_root" >&2
  exit 1
}

sync_directory() {
  local source_dir=$1
  local target_dir=$2

  [[ -d "$source_dir" ]] || {
    echo "error: source directory not found: $source_dir" >&2
    exit 1
  }

  mkdir -p "$target_dir"
  find "$target_dir" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
  cp -R "$source_dir"/. "$target_dir"/
}

# skills.sh installs only each skill directory, so shared protocol and
# templates a skill links to must be copied into that skill.
bundle_reference() {
  local skill=$1
  local source=$2
  local target_dir="$repo_root/skills/$skill/references"

  mkdir -p "$target_dir"
  install -m 0644 "$repo_root/$source" "$target_dir/$(basename "$source")"
}

bundle_reference contract-handoff templates/github/integration-contract.md
bundle_reference issue-explore templates/github/question.md
bundle_reference milestone-orchestrator protocol/AI_WORKFLOW.md
bundle_reference post-pr-audit protocol/REVIEW_POLICY.md
bundle_reference pr-audit protocol/REVIEW_POLICY.md
bundle_reference prepare-pr templates/pull-request.md
bundle_reference resolve-questions templates/github/decision.md

sync_directory "$repo_root/skills" "$plugin_root/skills"
sync_directory "$repo_root/protocol" "$plugin_root/protocol"
sync_directory "$repo_root/templates" "$plugin_root/templates"

mkdir -p "$plugin_root/scripts"
find "$plugin_root/scripts" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
for helper in issue-context pr-context workflow-status; do
  install -m 0755 "$repo_root/scripts/$helper" "$plugin_root/scripts/$helper"
done

echo "Synchronized plugin package: $plugin_root"
