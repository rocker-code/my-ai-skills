#!/usr/bin/env python3
"""Read-only lockfile and policy pre-flight checks (Python standard library)."""

import sys

sys.dont_write_bytecode = True

import argparse
import json
import subprocess
from pathlib import Path


DEFAULT_POLICY = (
    "AGENTS.md", "CLAUDE.md", ".github/workflows/", "openspec/config.yaml",
    ".ai-workflow/protocol/",
)


def packages(entries):
    if not isinstance(entries, list):
        raise ValueError("package list must be an array")
    result = {}
    for item in entries:
        if not isinstance(item, dict) or not isinstance(item.get("name"), str) or not isinstance(item.get("version"), str):
            raise ValueError("package needs name and version")
        result[item["name"]] = item["version"].removeprefix("v")
    return result


def read_json(path):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise ValueError(f"cannot read {path}: {exc}") from exc


def composer(root):
    lock = read_json(root / "composer.lock")
    if not isinstance(lock, dict):
        raise ValueError("composer.lock must be an object")
    expected = packages(lock.get("packages", [])) | packages(lock.get("packages-dev", []))
    installed_path = root / "vendor/composer/installed.json"
    if not installed_path.exists():
        return [{"ecosystem": "composer", "type": "not-installed", "path": "vendor/composer/installed.json"}]
    installed = read_json(installed_path)
    if isinstance(installed, dict):
        installed = installed.get("packages")
    actual = packages(installed)
    return compare("composer", expected, actual)


def npm(root):
    lock = read_json(root / "package-lock.json")
    if not isinstance(lock, dict) or not isinstance(lock.get("lockfileVersion"), int) or lock["lockfileVersion"] < 2:
        raise ValueError("package-lock.json requires lockfileVersion >= 2")
    expected = npm_packages(lock)
    installed_path = root / "node_modules/.package-lock.json"
    if not installed_path.exists():
        return [{"ecosystem": "npm", "type": "not-installed", "path": "node_modules/.package-lock.json"}]
    actual = npm_packages(read_json(installed_path))
    return compare("npm", expected, actual)


def npm_packages(data):
    if not isinstance(data, dict) or not isinstance(data.get("packages"), dict):
        raise ValueError("npm lock requires a packages object")
    result = {}
    for path, metadata in data["packages"].items():
        if path == "":  # Root project is not an installed dependency.
            continue
        if not isinstance(path, str) or not isinstance(metadata, dict) or not isinstance(metadata.get("version"), str):
            raise ValueError("npm package requires path and version")
        result[path] = metadata["version"].removeprefix("v")
    return result


def compare(ecosystem, expected, actual):
    findings = []
    for name, version in sorted(expected.items()):
        installed = actual.get(name)
        if installed != version:
            findings.append({"ecosystem": ecosystem, "type": "missing" if installed is None else "version-mismatch",
                             "package": name, "locked": version, "installed": installed})
    return findings


def lock_check(root, _args):
    checks = (("composer.lock", composer), ("package-lock.json", npm))
    found = [check for name, check in checks if (root / name).exists()]
    if not found:
        return "unsupported", [{"type": "unsupported", "message": "No supported lockfile; check manually"}]
    findings = [finding for check in found for finding in check(root)]
    return ("divergent" if findings else "ok"), findings


def git(root, *args):
    result = subprocess.run(["git", "-C", str(root), "--no-optional-locks", *args],
                            capture_output=True, check=False)
    if result.returncode:
        raise ValueError(result.stderr.decode("utf-8", "replace").strip() or "git command failed")
    return result.stdout


def policy_check(root, args):
    paths = (*DEFAULT_POLICY, *args.path)
    for path in paths:
        candidate = Path(path)
        if candidate.is_absolute() or ".." in candidate.parts or not path:
            raise ValueError(f"policy path must be repo-relative: {path}")
    rev = git(root, "rev-parse", "--verify", "--end-of-options", f"{args.since}^{{commit}}").strip().decode("ascii")
    changed = git(root, "diff", "--no-renames", "--name-status", "-z", rev, "--", *paths).split(b"\0")
    findings = []
    for index in range(0, len(changed) - 1, 2):
        findings.append({"type": changed[index].decode("utf-8", "replace"),
                         "path": changed[index + 1].decode("utf-8", "replace")})
    untracked = git(root, "ls-files", "--others", "--exclude-standard", "-z", "--", *paths)
    findings.extend({"type": "??", "path": path.decode("utf-8", "replace")}
                    for path in untracked.split(b"\0") if path)
    return ("changed" if findings else "ok"), findings


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path.cwd())
    parser.add_argument("--format", choices=("text", "json"), default="text")
    commands = parser.add_subparsers(dest="check", required=True)
    lock = commands.add_parser("lock")
    policy = commands.add_parser("policy")
    for command in (lock, policy):
        command.add_argument("--root", type=Path, default=argparse.SUPPRESS)
        command.add_argument("--format", choices=("text", "json"), default=argparse.SUPPRESS)
    policy.add_argument("--since", required=True)
    policy.add_argument("--path", action="append", default=[])
    args = parser.parse_args()
    try:
        root = args.root.resolve(strict=True)
        if not root.is_dir():
            raise ValueError("root must be a directory")
        status, findings = (lock_check if args.check == "lock" else policy_check)(root, args)
    except (ValueError, OSError) as exc:
        status, findings = "error", [{"type": "error", "message": str(exc)}]
    output = {"check": args.check, "status": status, "findings": findings}
    if args.format == "json":
        print(json.dumps(output, ensure_ascii=False, sort_keys=True))
    else:
        print(f"{args.check}: {status}")
        for finding in findings:
            print(json.dumps(finding, ensure_ascii=False, sort_keys=True))
    return 2 if status in ("error", "unsupported") else 1 if findings else 0


if __name__ == "__main__":
    sys.exit(main())
