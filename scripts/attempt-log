#!/usr/bin/env python3
"""Check the attempt-log block in an existing Apply handoff or PR validation."""
import sys

sys.dont_write_bytecode = True

import argparse
import json
from pathlib import Path

from attempt_log import MalformedLog, check, parse


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    command = sub.add_parser("check", help="validate an attempt-log JSON or Markdown handoff")
    command.add_argument("file", type=Path)
    command.add_argument("--final", action="store_true", help="require every group to be approved for PR")
    args = parser.parse_args()
    try:
        result = check(parse(args.file.read_text(encoding="utf-8")), final=args.final)
    except (MalformedLog, OSError, UnicodeError) as exc:
        print(json.dumps({"valid": False, "ready": False if args.final else None, "error": str(exc)}))
        return 2
    print(json.dumps(result, sort_keys=True))
    return 0 if result["valid"] and (not args.final or result["ready"]) else 1


if __name__ == "__main__":
    sys.exit(main())
