#!/usr/bin/env python3
"""Instalação local opt-in, sem sudo ou alteração de shell rc."""
import argparse
import os
from pathlib import Path

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--bin-dir", type=Path, default=Path.home() / ".local/bin")
args = parser.parse_args()
target = Path(__file__).resolve().with_name("aew")
destination = args.bin_dir.expanduser().absolute() / "aew"
try:
    destination.parent.mkdir(parents=True, exist_ok=True)
    if os.path.lexists(destination):
        if not destination.is_symlink() or destination.resolve() != target:
            parser.exit(1, "Instalação recusada: destino existente diferente.\n")
    else:
        destination.symlink_to(target)
except OSError:
    parser.exit(1, "Instalação indisponível: verifique o diretório bin.\n")
print(f"Instalado: {destination}. Inclua {destination.parent} no PATH se necessário.")
print(f"Mantenha o clone em {target.parent.parent}; não remova esta worktree enquanto usar o launcher.")
print("Desinstale somente este symlink; configuração e cache são preservados.")
