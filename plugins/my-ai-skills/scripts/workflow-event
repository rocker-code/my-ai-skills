#!/usr/bin/env python3
"""CLI manual; construção compartilhada com o coordenador estruturado."""
import sys

sys.dont_write_bytecode = True
from workflow_events import main

if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (RuntimeError, ValueError) as error:
        print(f"workflow-event: error: {error}", file=sys.stderr)
        raise SystemExit(1)
