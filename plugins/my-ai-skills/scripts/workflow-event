#!/usr/bin/env python3
"""Record workflow timing events in one durable GitHub issue comment per run."""

from __future__ import annotations

import argparse
import json
import re
import secrets
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from urllib.parse import urlsplit

sys.path.insert(0, str(Path(__file__).resolve().parent))
sys.dont_write_bytecode = True
from workflow_metrics import RUN_MARKER, iso_time, parse_run_comment  # noqa: E402

URL_PATTERN = re.compile(r"^https://github\.com/([^/]+/[^/]+)/(issues|milestone)/(\d+)/?$")
SAFE_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{0,99}$")
REASONS = {"owner_input", "dependency", "ci", "tests", "environment", "review", "runtime_capacity", "external", "other"}
REWORK_REASONS = {"review", "ci", "replan", "reopened", "other"}
SCOPES = {"single_issue", "project_queue", "milestone"}
EVIDENCE_REF_PATTERN = re.compile(r"^evidence:ev-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$")
SOURCES = {"runtime_event", "runtime_query", "ci_api", "process_exit", "test_report", "agent_prose", "container_state"}
CONFIRMING = SOURCES - {"agent_prose", "container_state"}
EXECUTION_KINDS = {"worker", "process", "job", "test_run", "ci_run"}
STATES = {"running", "completed", "failed", "interrupted", "unknown"}
REPORTS = {"present", "absent", "unknown"}
TYPED_REF = re.compile(r"(?!(?:https?|file):)[a-z][a-z0-9-]{1,30}:(?!.*//)[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}")


def validate_log_ref(value: str) -> bool:
    if len(value) > 256:
        return False
    if re.fullmatch(r"[a-fA-F0-9]{7,64}", value):
        return True
    if value.startswith("https://"):
        url = urlsplit(value)
        return (url.scheme == "https" and url.netloc == "github.com" and not url.port
                and not url.username and not url.password and not url.query and not url.fragment
                and bool(re.fullmatch(r"/[A-Za-z0-9._/-]+", url.path))
                and "//" not in url.path and ".." not in url.path.split("/") and "%" not in value)
    return bool(TYPED_REF.fullmatch(value))


def validated_time(value: str | None, created_at: str, now: datetime) -> str:
    if value is None:
        return iso_time(now)
    try:
        parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as error:
        raise ValueError("--observed-at must be ISO-8601 with timezone") from error
    if parsed.tzinfo is None or parsed.utcoffset() is None:
        raise ValueError("--observed-at must include a timezone")
    parsed = parsed.astimezone(timezone.utc)
    started = datetime.fromisoformat(created_at.replace("Z", "+00:00"))
    if parsed < started or parsed > now + timedelta(seconds=120):
        raise ValueError("--observed-at must be within run start and current time (+120s)")
    return iso_time(parsed)


def execution_of(event: dict) -> dict | None:
    return event.get("execution") if isinstance(event.get("execution"), dict) else None


def opening_for(record: dict, stage: str, worker: str, execution: dict | None, at: str,
                *, open_only: bool = False) -> dict | None:
    """Find an incarnation for a callback or an untyped FIFO stage close."""
    # The reader sorts by effective time, stably breaking ties by record order.
    # Use that same opening/closing order for FIFO and incarnation windows.
    starts = sorted((event for event in record["events"] if event.get("type") == "stage_started"
                     and event.get("stage") == stage and (event.get("worker_id") or "orchestrator") == worker),
                    key=lambda event: event["at"])
    ends = sorted((event for event in record["events"] if event.get("type") in {"stage_finished", "stage_failed"}
                   and event.get("stage") == stage and (event.get("worker_id") or "orchestrator") == worker),
                  key=lambda event: event["at"])
    if open_only and execution is None:
        # Administrative untyped closes pair by opening order, even when
        # openings overlap. Observation windows intentionally do not: an
        # untyped callback may not confirm the earlier incarnation after the
        # next opening of the pair.
        untyped_starts = [item for item in starts if execution_of(item) is None]
        untyped_ends = [item for item in ends if execution_of(item) is None]
        next_start = untyped_starts[len(untyped_ends):len(untyped_ends) + 1]
        return next_start[0] if next_start and next_start[0]["at"] <= at else None
    candidates = []
    untyped_ends = [item for item in ends if execution_of(item) is None]
    for index, start in enumerate(starts):
        if execution_of(start) != execution or start["at"] > at:
            continue
        matching_ends = [end for end in ends if execution_of(end) == execution and end["at"] >= start["at"]]
        if not execution:
            # Legacy starts/ends are paired FIFO; an end belongs to this start by ordinal.
            ordinal = sum(1 for item in starts[:index] if execution_of(item) is None)
            matching_ends = untyped_ends[ordinal:ordinal + 1]
        closed_at = matching_ends[0]["at"] if matching_ends else None
        if open_only and closed_at is not None:
            continue
        if execution and closed_at is not None and at > closed_at:
            continue
        if not execution:
            if sum(1 for item in starts if item["at"] == start["at"] and execution_of(item) is None) > 1:
                continue
            later = [item["at"] for item in starts[index + 1:]]
            if (closed_at and at > closed_at) or (later and at >= min(later)):
                continue
        candidates.append(start)
    return candidates[0] if len(candidates) == 1 else None


def gh(*args: str, input_text: str | None = None) -> str:
    result = subprocess.run(["gh", *args], input=input_text, text=True, capture_output=True)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or f"gh exited with status {result.returncode}")
    return result.stdout


def parse_issue_url(value: str) -> tuple[str, int]:
    match = URL_PATTERN.fullmatch(value)
    if not match or match.group(2) != "issues":
        raise ValueError("--issue must be a GitHub issue URL")
    return match.group(1), int(match.group(3))


def read_comments(repo: str, number: int) -> list[dict]:
    pages = json.loads(gh("api", "--paginate", "--slurp", f"repos/{repo}/issues/{number}/comments"))
    return [item for page in pages for item in page]


def comment_body(record: dict) -> str:
    latest = record["events"][-1]
    line = f"My AI Skills workflow run {record['run_id']} — {record['status']}"
    if latest.get("stage"):
        line += f" — etapa: {latest['stage']}"
    payload = json.dumps(record, ensure_ascii=False, separators=(",", ":"))
    return (
        f"{line}\n\n{RUN_MARKER}\n"
        f"<!-- my-ai-skills-workflow-data:start -->\n{payload}\n"
        "<!-- my-ai-skills-workflow-data:end -->"
    )


def save_record(repo: str, issue: int, record: dict, existing_comment_id: int | None) -> None:
    body = comment_body(record)
    if existing_comment_id is None:
        gh("api", f"repos/{repo}/issues/{issue}/comments", "-f", f"body={body}")
    else:
        gh("api", "--method", "PATCH", f"repos/{repo}/issues/comments/{existing_comment_id}", "-f", f"body={body}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("event", choices={"new-run-id", "run-start", "stage-start", "stage-end", "wait-start", "wait-end", "run-end", "rework", "dispatch", "observe"})
    parser.add_argument("--issue")
    parser.add_argument("--run-id")
    parser.add_argument("--scope", choices=sorted(SCOPES), default="single_issue")
    parser.add_argument("--milestone-url")
    parser.add_argument("--worker-id", default="orchestrator")
    parser.add_argument("--stage")
    parser.add_argument("--agent")
    parser.add_argument("--model")
    parser.add_argument("--reason", choices=sorted(REASONS | REWORK_REASONS))
    parser.add_argument("--status", choices={"completed", "failed"})
    parser.add_argument("--evidence", action="append", default=[])
    parser.add_argument("--execution-kind", choices=sorted(EXECUTION_KINDS))
    parser.add_argument("--execution-id")
    parser.add_argument("--observed-at")
    parser.add_argument("--source", choices=sorted(SOURCES))
    parser.add_argument("--state", choices=sorted(STATES))
    parser.add_argument("--exit-code", type=int)
    parser.add_argument("--report", choices=sorted(REPORTS))
    parser.add_argument("--log-ref")
    parser.add_argument("--next", dest="next_action")
    args = parser.parse_args()

    if args.event == "new-run-id":
        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        print(f"wf-{stamp}-{secrets.token_hex(4)}")
        return 0

    if not args.issue:
        parser.error("--issue is required")
    repo, issue_number = parse_issue_url(args.issue)
    if not args.run_id and args.event != "run-start":
        parser.error("--run-id is required for this event")
    run_id = args.run_id
    if args.event == "run-start" and not run_id:
        stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        run_id = f"wf-{stamp}-{secrets.token_hex(4)}"
    if not SAFE_ID.fullmatch(run_id or ""):
        parser.error("--run-id contains unsupported characters")
    if args.event in {"stage-start", "stage-end", "wait-start", "wait-end", "rework", "dispatch", "observe"}:
        if not args.stage or not SAFE_ID.fullmatch(args.stage):
            parser.error("a safe --stage identifier is required for stage/wait events")
    if args.event in {"wait-start", "wait-end"} and args.reason not in REASONS:
        parser.error("--reason is required for wait events")
    if args.event == "stage-end" and args.status not in {"completed", "failed"}:
        parser.error("--status completed|failed is required for stage-end")
    if args.event == "run-end" and args.status not in {"completed", "failed"}:
        parser.error("--status completed|failed is required for run-end")
    if bool(args.execution_kind) != bool(args.execution_id) or (args.execution_id and not SAFE_ID.fullmatch(args.execution_id)):
        parser.error("--execution-kind and safe --execution-id must be supplied together")
    if args.event == "dispatch" and args.worker_id == "orchestrator":
        parser.error("dispatch requires a non-orchestrator --worker-id")
    if args.event == "observe" and (not args.state or not args.source):
        parser.error("observe requires --state and --source")
    if args.next_action and (len(args.next_action) > 160 or any(ord(char) < 32 or ord(char) == 127 for char in args.next_action)):
        parser.error("--next must be one line of at most 160 characters")
    if args.log_ref and not validate_log_ref(args.log_ref):
        parser.error("--log-ref must be a safe GitHub URL, SHA or typed reference")
    if args.scope == "milestone" and not args.milestone_url:
        parser.error("--milestone-url is required when --scope=milestone")
    if args.milestone_url:
        milestone_match = re.fullmatch(r"https://github\.com/([^/]+/[^/]+)/milestone/\d+/?", args.milestone_url)
        if not milestone_match or milestone_match.group(1) != repo:
            parser.error("--milestone-url must belong to the issue repository")

    for evidence in args.evidence:
        if not (evidence.startswith("https://github.com/") or re.fullmatch(r"[a-fA-F0-9]{7,64}", evidence)
                or EVIDENCE_REF_PATTERN.fullmatch(evidence)):
            parser.error("--evidence must be a GitHub URL, commit SHA or evidence:<evidence_id>")

    comments = read_comments(repo, issue_number)
    matches = [(item, parse_run_comment(item.get("body", ""))) for item in comments]
    matches = [(item, data) for item, data in matches if data and data.get("run_id") == run_id]
    if len(matches) > 1:
        raise RuntimeError(f"run {run_id} has duplicate records on issue #{issue_number}; refusing to overwrite")
    if args.event == "run-start":
        if matches:
            raise RuntimeError(f"run {run_id} already exists on issue #{issue_number}")
        at = iso_time()
        record = {
            "schema_version": 1, "run_id": run_id, "repository": repo,
            "scope": args.scope, "milestone_url": args.milestone_url,
            "issue": {"number": issue_number, "url": args.issue},
            "status": "running", "created_at": at, "finished_at": None,
            "events": [], "evidence": [],
        }
        existing_id = None
        event = {"type": "run_started", "at": at, "worker_id": args.worker_id, "agent": args.agent, "model": args.model}
    else:
        if not matches:
            raise RuntimeError(f"run {run_id} was not found on issue #{issue_number}; start it first")
        comment, record = matches[-1]
        existing_id = comment["id"]
        now = datetime.now(timezone.utc)
        at = validated_time(args.observed_at, record["created_at"], now)
        event = {"type": None, "at": at, "recorded_at": iso_time(now), "worker_id": args.worker_id}
        if args.agent:
            event["agent"] = args.agent
        if args.model:
            event["model"] = args.model
        if args.stage:
            event["stage"] = args.stage
        if args.reason:
            event["reason"] = args.reason
        if args.status:
            event["status"] = args.status
        if args.evidence:
            event["evidence"] = args.evidence
        if args.execution_id:
            event["execution"] = {"kind": args.execution_kind, "id": args.execution_id}
        if args.source:
            event["source"] = args.source
        if args.next_action:
            event["next"] = args.next_action
        if args.event == "observe":
            event.update(state=args.state, confirming=args.source in CONFIRMING)
            for key, value in (("exit_code", args.exit_code), ("report", args.report), ("log_ref", args.log_ref)):
                if value is not None:
                    event[key] = value
        if args.event == "dispatch":
            event["dispatch"] = "async"

        if args.event in {"stage-start", "dispatch", "wait-start"} and record.get("finished_at"):
            raise ValueError("cannot open a stage or wait on a finished run")
        if args.event in {"stage-start", "dispatch"} and args.execution_id:
            if any(e.get("type") == "stage_started" and e.get("stage") == args.stage
                   and (e.get("worker_id") or "orchestrator") == args.worker_id
                   and execution_of(e) == event["execution"] for e in record["events"]):
                raise ValueError("execution id already used for this stage and worker")
        if args.event in {"stage-start", "dispatch"}:
            # An opening can change the effective-time window of an already
            # correlated untyped callback (even when the new opening is typed).
            # Do not rewrite history by inserting it ahead of that callback.
            pair = [e for e in record["events"] if e.get("stage") == args.stage
                    and (e.get("worker_id") or "orchestrator") == args.worker_id]
            if any(e.get("type") == "state_observed" and execution_of(e) is None
                   and e["at"] >= at
                   and opening_for(record, args.stage, args.worker_id, None, e["at"]) is not None
                   for e in pair):
                raise ValueError("backdated opening would reassign an existing observation")
        if args.event in {"stage-start", "dispatch"} and not args.execution_id:
            pair_starts = [e["at"] for e in record["events"]
                          if e.get("type") == "stage_started"
                          and e.get("stage") == args.stage
                          and (e.get("worker_id") or "orchestrator") == args.worker_id
                          and execution_of(e) is None]
            pair_ends = [e["at"] for e in record["events"]
                         if e.get("type") in {"stage_finished", "stage_failed"}
                         and e.get("stage") == args.stage
                         and (e.get("worker_id") or "orchestrator") == args.worker_id
                         and execution_of(e) is None]
            if (pair_starts and at <= max(pair_starts)) or (pair_ends and at <= max(pair_ends)):
                raise ValueError("backdated untyped stage-start would change FIFO pairing")
        if args.event in {"wait-start", "wait-end"}:
            same_wait = [e for e in record["events"] if e.get("stage") == args.stage
                         and (e.get("worker_id") or "orchestrator") == args.worker_id
                         and e.get("reason") == args.reason]
            starts = [e for e in same_wait if e.get("type") == "wait_started"]
            ends = [e for e in same_wait if e.get("type") == "wait_finished"]
            if args.event == "wait-start":
                if (starts and at < starts[-1]["at"]) or (ends and at <= ends[-1]["at"]):
                    raise ValueError("backdated wait-start would change FIFO pairing")
            elif (not starts or len(ends) >= len(starts) or at < starts[len(ends)]["at"]
                  or (ends and at < ends[-1]["at"])):
                raise ValueError("wait-end has no matching open wait at effective time")
        if args.event in {"observe", "stage-end"}:
            if args.event == "stage-end" and not args.execution_id:
                prior_ends = [e["at"] for e in record["events"]
                              if e.get("type") in {"stage_finished", "stage_failed"}
                              and e.get("stage") == args.stage
                              and (e.get("worker_id") or "orchestrator") == args.worker_id
                              and execution_of(e) is None]
                if prior_ends and at < max(prior_ends):
                    raise ValueError("backdated untyped stage-end would change FIFO pairing")
            opening = opening_for(record, args.stage, args.worker_id, execution_of(event), at,
                                  open_only=args.event == "stage-end")
            if opening and at < opening["at"]:
                raise ValueError("observation precedes dispatch")
            if args.event == "stage-end":
                if not opening:
                    raise ValueError("stage-end has no matching open execution")
            elif args.execution_id:
                starts = [e for e in record["events"] if e.get("type") == "stage_started"
                          and e.get("stage") == args.stage
                          and (e.get("worker_id") or "orchestrator") == args.worker_id
                          and execution_of(e) == execution_of(event)]
                if starts and at < starts[0]["at"]:
                    raise ValueError("observation precedes dispatch")
            elif args.observed_at:
                starts = [e for e in record["events"] if e.get("type") == "stage_started"
                          and e.get("stage") == args.stage and (e.get("worker_id") or "orchestrator") == args.worker_id
                          and execution_of(e) == execution_of(event)]
                if starts and at < starts[0]["at"]:
                    raise ValueError("observation precedes dispatch")

    if args.event == "rework" and not args.reason:
        parser.error("--reason is required for rework")
    event_types = {
        "stage-start": "stage_started", "dispatch": "stage_started", "observe": "state_observed",
        "stage-end": "stage_finished" if args.status == "completed" else "stage_failed",
        "wait-start": "wait_started", "wait-end": "wait_finished",
        "run-end": "run_finished", "rework": "rework",
    }
    if args.event != "run-start":
        event["type"] = event_types[args.event]
    if args.event == "observe":
        target = opening_for(record, args.stage, args.worker_id, execution_of(event), at)
        matching = [e for e in record["events"] if e.get("type") == "state_observed"
                    and e.get("stage") == args.stage and (e.get("worker_id") or "orchestrator") == args.worker_id
                    and execution_of(e) == execution_of(event)
                    and target is not None
                    and opening_for(record, args.stage, args.worker_id, execution_of(e), e["at"]) is target]
        facts = ("state", "source", "exit_code", "report", "log_ref", "evidence", "next")
        if matching and all(matching[-1].get(key) == event.get(key) for key in facts):
            matching[-1]["last_seen_at"] = event["recorded_at"]
            record["updated_at"] = event["recorded_at"]
            save_record(repo, issue_number, record, existing_id)
            print(json.dumps({"run_id": run_id, "issue": args.issue, "event": "state_observed", "deduplicated": True}))
            return 0
    record["events"].append(event)
    if args.evidence:
        record["evidence"].extend(args.evidence)
    if args.event == "run-end":
        record["status"] = args.status
        record["finished_at"] = at
    elif args.event == "run-start":
        record["status"] = "running"
    record["updated_at"] = at
    save_record(repo, issue_number, record, existing_id)
    print(json.dumps({"run_id": run_id, "issue": args.issue, "event": event["type"], "at": at}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (RuntimeError, ValueError) as error:
        print(f"workflow-event: error: {error}", file=sys.stderr)
        raise SystemExit(1)
